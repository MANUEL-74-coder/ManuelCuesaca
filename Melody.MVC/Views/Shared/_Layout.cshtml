<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Melody</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/melody-layout.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <!-- Overlay para cerrar sidebar en móvil -->
    <div class="sidebar-overlay" onclick="closeSidebar()"></div>

    <div class="layout-container">
        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <h3>🎵 Melody</h3>
                <button class="sidebar-close" onclick="closeSidebar()">✕</button>
            </div>

            <div class="sidebar-nav">
                <!-- Navegación Principal -->
                <ul class="nav-section">
                    <li><a asp-controller="Home" asp-action="Index">🏠 Inicio</a></li>
                    <li><a asp-controller="Canciones" asp-action="Index">🔍 Explorar</a></li>
                    <li><a asp-controller="Artistas" asp-action="Index">👨‍🎤 Artistas</a></li>
                    <li><a asp-controller="Albums" asp-action="Index">💿 Álbumes</a></li>
                    <li><a asp-controller="Playlists" asp-action="Index">📋 Playlists</a></li>
                </ul>

                <!-- Admin -->
                @if (User.IsInRole("admin"))
                {
                    <div class="nav-divider">Administración</div>
                    <ul class="nav-section">
                        <li><a asp-controller="Usuarios" asp-action="Index">👥 Usuarios</a></li>
                        <li><a asp-controller="Planes" asp-action="Index">💎 Planes</a></li>
                        <li><a asp-controller="Suscripciones" asp-action="Estadisticas">📊 Estadísticas</a></li>
                        <li><a asp-controller="Seguimientos" asp-action="MisSeguimientos">📈 Reportes</a></li>
                    </ul>
                }

                <!-- Artista -->
                @if (User.IsInRole("artista"))
                {
                    <div class="nav-divider">Mi Música</div>
                    <ul class="nav-section">
                        <li><a asp-controller="Artistas" asp-action="MiPerfil">🎤 Mi Perfil</a></li>
                        <li><a asp-controller="Canciones" asp-action="MisCanciones">🎵 Mis Canciones</a></li>
                        <li><a asp-controller="Albums" asp-action="MisAlbums">💿 Mis Álbumes</a></li>
                        <li><a asp-controller="Canciones" asp-action="Create">⬆️ Subir Música</a></li>
                        <li><a asp-controller="Seguimientos" asp-action="MisSeguimientos">⭐ Seguidos</a></li>
                    </ul>
                }

                <!-- Usuario -->
                @if (User.IsInRole("userfree") || User.IsInRole("userpremium"))
                {
                    <div class="nav-divider">Tu Biblioteca</div>
                    <ul class="nav-section">
                        <li><a asp-controller="Seguimientos" asp-action="MisSeguimientos">⭐ Seguidos</a></li>
                        <li><a asp-controller="MeGusta" asp-action="Index"> ❤️ Favoritos</a></li>
                        <li><a asp-controller="Pagos" asp-action="MisPagos">💳 Mis Pagos</a></li>
                        <li><a asp-controller="Suscripciones" asp-action="MiSuscripcion">💎 Suscripción</a></li>
                        <li><a asp-controller="Playlists" asp-action="MisPlaylists">📋 Mis Playlists</a></li>

                        @if (User.IsInRole("userfree"))
                        {
                            <li><a asp-controller="Planes" asp-action="Index">⬆️ Premium</a></li>
                        }
                    </ul>
                }
            </div>
        </nav>

        <!-- Contenido Principal -->
        <div class="main-content">
            <!-- Header con búsqueda y perfil -->
            <header class="top-header">
                <div class="header-left">
                    <button class="hamburger-btn" onclick="toggleSidebar()">☰</button>
                    <form asp-controller="Canciones" asp-action="Buscar" class="search-form">
                        <input type="text" name="q" placeholder="🔍 Buscar música..." />
                        <button type="submit">Buscar</button>
                    </form>
                </div>

                <div class="header-right">
                    @if (User.IsInRole("userfree"))
                    {
                        <a asp-controller="Planes" asp-action="Index" class="premium-btn">✨ Premium</a>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="user-dropdown">
                            <button class="user-btn" onclick="toggleUserMenu()">
                                <span class="user-icon">👤</span>
                                <span class="user-name">@User.Identity.Name</span>
                                <span class="user-arrow">▼</span>
                            </button>
                            <div class="user-menu" id="userMenu">
                                <a asp-controller="Usuarios" asp-action="MiPerfil">👤 Mi Perfil</a>
                                <a asp-controller="Auth" asp-action="Salir">🚪 Cerrar Sesión</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="login-btn">🔑 Login</a>
                    }
                </div>
            </header>

            <!-- Contenido -->
            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Reproductor de Audio Fijo -->
    <div id="globalAudioPlayer" class="audio-player">
        <div class="player-info">
            <img id="globalCurrentCover" src="/images/default-song.png" alt="Cover" />
            <div>
                <div id="globalCurrentTitle">Selecciona una canción</div>
                <div id="globalCurrentArtist">para reproducir</div>
            </div>
        </div>
        <div class="player-controls">
            <button onclick="globalPreviousSong()">⏮</button>
            <button id="globalPlayPauseBtn" onclick="globalTogglePlayPause()">▶️</button>
            <button onclick="globalNextSong()">⏭</button>
        </div>
        <div class="player-progress">
            <span id="globalCurrentTime">0:00</span>
            <input type="range" id="globalProgressBar" onchange="globalSeekAudio(this.value)" />
            <span id="globalTotalTime">0:00</span>
        </div>
    </div>

    <audio id="globalAudioElement" ontimeupdate="globalUpdateProgress()" onended="globalNextSong()"></audio>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/melody-layout.js" asp-append-version="true"></script>
    <script src="~/js/global-audio-player.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>