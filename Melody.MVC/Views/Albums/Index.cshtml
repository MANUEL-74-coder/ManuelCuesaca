@model IEnumerable<Melody.Modelos.DTOs.AlbumDto>
@{
    ViewData["Title"] = "Álbumes";
}
<div class="albums-index">
    <h2>Álbumes</h2>
    <form method="get" asp-action="Buscar" class="search-form">
        <input type="text" name="q" class="search-input" placeholder="Buscar álbumes..." value="@ViewBag.TerminoBusqueda">
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="albums-grid">
            @foreach (var album in Model)
            {
                <div class="album-card">
                    <div class="card-image">
                        @if (!string.IsNullOrEmpty(album.PortadaUrl))
                        {
                            <img src="@album.PortadaUrl" alt="@album.Titulo">
                        }
                        else
                        {
                            <div class="no-image">
                                <span>Sin portada</span>
                            </div>
                        }
                    </div>
                    <div class="card-content">
                        <a href="@Url.Action("Details", new { id = album.Id })" class="card-title">@album.Titulo</a>
                        <p class="card-artist">Por: @album.NombreArtista</p>
                        <p class="card-details">@album.GeneroNombre</p>
                        <p class="card-details">@album.TotalCanciones canción(es)</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h4>No hay álbumes disponibles</h4>
            <p>Aún no se han creado álbumes en la plataforma.</p>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/album.css" asp-append-version="true" />
}