@model Melody.Modelos.DTOs.CrearAlbumDto

@{
    ViewData["Title"] = "Crear Álbum";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>🎵 Crear Nuevo Álbum</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label">Título del Álbum *</label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ingresa el título de tu álbum">
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GeneroId" class="form-label">Género *</label>
                            <select asp-for="GeneroId" class="form-select" asp-items="ViewBag.Generos">
                                <option value="">Selecciona un género</option>
                            </select>
                            <span asp-validation-for="GeneroId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Portada" class="form-label">Portada del Álbum</label>
                            <input asp-for="Portada" type="file" class="form-control" accept="image/*">
                            <span asp-validation-for="Portada" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("MisAlbums")" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Crear Álbum</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}