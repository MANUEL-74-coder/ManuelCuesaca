@model Melody.Modelos.DTOs.AlbumDto
@{
    ViewData["Title"] = "Eliminar Álbum";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🗑️ Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>¿Estás seguro de que deseas eliminar este álbum?</strong>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(Model.PortadaUrl))
                            {
                                <img src="@Model.PortadaUrl" alt="Portada de @Model.Titulo" class="img-fluid rounded">
                            }
                            else
                            {
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center">
                                    <i class="bi bi-music-note-beamed text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h5 class="card-title">@Model.Titulo</h5>
                            <p class="card-text">
                                <strong>Artista:</strong> @Model.NombreArtista<br>
                                <strong>Canciones:</strong> @Model.TotalCanciones canción(es)<br>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("MisAlbums")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar Álbum
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>