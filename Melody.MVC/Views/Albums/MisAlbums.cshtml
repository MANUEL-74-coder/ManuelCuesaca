@model IEnumerable<Melody.Modelos.Album>
@{
    ViewData["Title"] = "MisAlbums";
}

<div class="mis-albums">
    <div class="page-header">
        <h2>Mis Álbumes</h2>
        <a href="@Url.Action("Create")" class="primary-button">Subir nuevo Álbum</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert success-alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error-alert">
            @TempData["Error"]
        </div>
    }

    @if (Model.Any())
    {
        <div class="albums-list">
            @foreach (var item in Model)
            {
                <div class="album-item">
                    <div class="album-image">
                        @if (!string.IsNullOrEmpty(item.PortadaUrl))
                        {
                            <img src="@item.PortadaUrl" alt="@item.Titulo">
                        }
                        else
                        {
                            <div class="no-image">🎵</div>
                        }
                    </div>

                    <div class="album-info">
                        <a href="@Url.Action("Details", new { id = item.Id })" class="album-title">@item.Titulo</a>
                        <p class="album-details">
                            <strong>@item.Artista?.NombreArtista</strong> •
                            @item.Genero?.Nombre •
                            @item.FechaLanzamiento.ToString("dd/MM/yyyy") •
                            @(item.Canciones?.Count ?? 0) canción(es)
                        </p>

                        @if (ViewBag.CancionesSinAlbum != null && ((List<Melody.Modelos.DTOs.CancionDto>)ViewBag.CancionesSinAlbum).Any())
                        {
                            <form method="post" action="@Url.Action("AgregarCancionAAlbum")" class="cancion-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="albumId" value="@item.Id" />
                                <div class="form-group">
                                    <select name="cancionId" class="form-select" required>
                                        <option value="">Agregar canción al álbum...</option>
                                        @foreach (var cancion in (List<Melody.Modelos.DTOs.CancionDto>)ViewBag.CancionesSinAlbum)
                                        {
                                            <option value="@cancion.Id">@cancion.Titulo</option>
                                        }
                                    </select>
                                    <button type="submit" class="add-button">+ Agregar</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="no-songs">No hay canciones disponibles para agregar</p>
                        }
                    </div>

                    <div class="album-actions">
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="edit-button">Editar</a>
                        <a href="@Url.Action("ConfirmarDelete", new { id = item.Id })" class="delete-button">Eliminar</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h4>No tienes álbumes aún</h4>
            <p>Sube tu primer álbum para comenzar</p>
            <a href="@Url.Action("Create")" class="primary-button">Subir nuevo Álbum</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/album.css" asp-append-version="true" />
}