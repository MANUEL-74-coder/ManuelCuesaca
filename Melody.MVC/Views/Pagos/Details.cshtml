@model Melody.Modelos.Pago
@{
    ViewData["Title"] = "Detalles del Pago";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>@ViewData["Title"]</h2>
                <a href="@Url.Action("MisPagos")" class="btn btn-secondary">
                    ← Volver al Historial
                </a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Información del Pago #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Detalles del Pago</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Fecha:</strong></td>
                                    <td>@Model.FechaPago.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <td><strong>Monto:</strong></td>
                                    <td><span class="h5 text-success">$@Model.Monto.ToString("F2")</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Método:</strong></td>
                                    <td><span class="badge bg-info">@Model.MetodoPago</span></td>
                                </tr>
                            </table>
                        </div>

                        @if (Model.Suscripcion != null)
                        {
                            <div class="col-md-6">
                                <h6>Información de la Suscripción</h6>
                                <table class="table table-borderless">
                                    @if (Model.Suscripcion.Plan != null)
                                    {
                                        <tr>
                                            <td><strong>Plan:</strong></td>
                                            <td>@Model.Suscripcion.Plan.Nombre</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Descripción:</strong></td>
                                            <td>@Model.Suscripcion.Plan.Descripcion</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td><strong>Inicio:</strong></td>
                                        <td>@Model.Suscripcion.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Vencimiento:</strong></td>
                                        <td>@Model.Suscripcion.FechaFin.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Estado:</strong></td>
                                        <td>
                                            @if (Model.Suscripcion.EsActiva)
                                            {
                                                <span class="badge bg-success">Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactiva</span>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="@Url.Action("DescargarPDF", new { pagoId = Model.Id })"
                       class="btn btn-success">
                        📄 Descargar Comprobante PDF
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>