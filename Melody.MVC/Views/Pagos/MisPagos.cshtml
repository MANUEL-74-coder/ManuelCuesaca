@model IEnumerable<Melody.Modelos.Pago>
@{
    ViewData["Title"] = "Mi Historial de Pagos";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Plan</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Período</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model)
                            {
                                <tr>
                                    <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (pago.Suscripcion?.Plan != null)
                                        {
                                            @pago.Suscripcion.Plan.Nombre
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>$@pago.Monto.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@pago.MetodoPago</span>
                                    </td>
                                    <td>
                                        @if (pago.Suscripcion != null)
                                        {
                                            <small>
                                                @pago.Suscripcion.FechaInicio.ToString("dd/MM/yyyy") -
                                                @pago.Suscripcion.FechaFin.ToString("dd/MM/yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { pagoId = pago.Id })"
                                               class="btn btn-outline-primary btn-sm">
                                                Ver Detalles
                                            </a>
                                            <a href="@Url.Action("DescargarPDF", new { pagoId = pago.Id })"
                                               class="btn btn-outline-success btn-sm">
                                                📄 PDF
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No tienes pagos registrados</h4>
                    <p class="text-muted">Cuando realices tu primer pago aparecerá aquí.</p>
                    <a href="@Url.Action("Index", "Planes")" class="btn btn-primary">
                        Ver Planes Disponibles
                    </a>
                </div>
            }
        </div>
    </div>
</div>