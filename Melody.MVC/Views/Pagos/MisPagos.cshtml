@model List<Melody.Modelos.Pago>
@{
    ViewData["Title"] = "Historial de Pagos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-receipt"></i> @ViewData["Title"]</h2>
        <a asp-controller="Planes" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nueva Suscripción
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-calendar"></i> Fecha</th>
                                <th><i class="fas fa-tag"></i> Plan</th>
                                <th><i class="fas fa-dollar-sign"></i> Monto</th>
                                <th><i class="fas fa-credit-card"></i> Método</th>
                                <th><i class="fas fa-cog"></i> Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model)
                            {
                                <tr>
                                    <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (pago.Suscripcion?.Plan != null)
                                        {
                                            <span class="badge bg-primary">@pago.Suscripcion.Plan.Nombre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Plan no disponible</span>
                                        }
                                    </td>
                                    <td class="text-success fw-bold">$@pago.Monto.ToString("F2")</td>
                                    <td>
                                        <i class="fab fa-paypal text-primary"></i> @pago.MetodoPago
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-pagoId="@pago.Id"
                                               class="btn btn-outline-info btn-sm" title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="DescargarPDF" asp-route-pagoId="@pago.Id"
                                               class="btn btn-outline-primary btn-sm" title="Descargar PDF">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                <h5>No tienes pagos registrados</h5>
                <p class="text-muted">Cuando realices tu primera compra, aparecerá aquí.</p>
                <a asp-controller="Planes" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-shopping-cart"></i> Ver Planes Disponibles
                </a>
            </div>
        </div>
    }

    <!-- Información adicional -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <h6><i class="fas fa-info-circle"></i> Información</h6>
                    <p class="mb-0 small text-muted">
                        Todos los comprobantes están disponibles para descarga en formato PDF.
                        Si tienes problemas con algún pago, contacta a soporte.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>