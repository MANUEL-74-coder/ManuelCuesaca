@model Melody.Modelos.Suscripcion
@{
    ViewData["Title"] = "Pago Confirmado";
    var pagoId = ViewBag.PagoId as int? ?? 0;
    var hasError = ViewBag.Error as bool? ?? false;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (hasError)
            {
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark text-center">
                        <h3><i class="fas fa-exclamation-triangle"></i> Pago Procesado</h3>
                    </div>
                    <div class="card-body text-center">
                        <div class="alert alert-warning">
                            <h4>Pago realizado con éxito</h4>
                            <p>Tu suscripción está siendo procesada.</p>
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home"></i> Ir al Dashboard
                        </a>
                    </div>
                </div>
            }
            else if (Model != null)
            {
                <div class="card border-success">
                    <div class="card-header bg-success text-white text-center">
                        <h3><i class="fas fa-check-circle"></i> ¡Pago Exitoso!</h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-success text-center">
                            <h4>¡Bienvenido a Melody Premium!</h4>
                            <p>Tu suscripción está activa y lista para usar.</p>
                        </div>

                        @if (Model.Plan != null)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Plan:</strong> @Model.Plan.Nombre
                                </div>
                                <div class="col-md-6">
                                    <strong>Precio:</strong> $@Model.Plan.Precio
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Fecha inicio:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")
                                </div>
                                <div class="col-md-6">
                                    <strong>Válido hasta:</strong> @Model.FechaFin.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        }

                        <div class="text-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                                <i class="fas fa-home"></i> Ir al Dashboard
                            </a>
                            <a asp-controller="Suscripciones" asp-action="MisSuscripciones" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-list"></i> Mi Suscripción
                            </a>
                            @if (pagoId > 0)
                            {
                                <a asp-action="DescargarPDF" asp-route-pagoId="@pagoId" class="btn btn-outline-primary">
                                    <i class="fas fa-download"></i> Descargar Comprobante
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-success">
                    <div class="card-header bg-success text-white text-center">
                        <h3><i class="fas fa-check-circle"></i> ¡Pago Exitoso!</h3>
                    </div>
                    <div class="card-body text-center">
                        <div class="alert alert-success">
                            <h4>¡Bienvenido a Melody Premium!</h4>
                            <p>Tu suscripción está activa y lista para usar.</p>
                        </div>
                        <div class="text-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                                <i class="fas fa-home"></i> Ir al Dashboard
                            </a>
                            <a asp-controller="Planes" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-list"></i> Ver Planes
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>