@model Melody.Modelos.DTOs.LoginDto
@{
    ViewData["Title"] = "Iniciar Sesión - Melody Stream";
   
}
<html>

<head>
    <meta charset="utf-8" />
    <title>Registro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/Auth.css" />
</head>

<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-header text-center bg-primary text-white">
                        <h3>Melody Stream</h3>
                        <p class="mb-0">Inicia sesión en tu cuenta</p>
                    </div>
                    <div class="card-body p-4">

                        <!-- Mensaje de éxito de PAGO -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle"></i> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <!-- Mensaje de éxito (cuando viene del registro) -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <!-- Mensajes de error generales -->
                            <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Correo Electrónico</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="tu@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label">Contraseña</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Tu contraseña" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">Iniciar Sesión</button>
                            </div>
                        </form>


                        <div class="text-center">
                            <p class="mb-2">
                                ¿No tienes cuenta?
                                <a asp-action="Registro" class="text-primary text-decoration-none">Regístrate aquí</a>
                            </p>
                            <p class="mb-0">
                                ¿Olvidaste tu contraseña?
                                <a asp-action="ForgotPassword" class="text-primary text-decoration-none">Recuperala aquí</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}