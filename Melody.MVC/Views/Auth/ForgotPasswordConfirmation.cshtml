@{
    ViewData["Title"] = "Email Enviado - Melody Stream";
    Layout = null;
}
<html>
<head>
    <meta charset="utf-8" />
    <title>Email Enviado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow">
                    <div class="card-header text-center bg-primary text-white">
                        <h3>Melody Stream</h3>
                        <p class="mb-0">Email enviado exitosamente</p>
                    </div>
                    <div class="card-body p-4 text-center">

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-info" role="alert">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <div class="mb-4">
                            <h4>¡Revisa tu correo!</h4>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <strong>Importante:</strong>
                            <ul class="mb-0 text-start">
                                <li>El enlace expirará en 30 minutos</li>
                                <li>Revisa también tu carpeta de spam</li>
                                <li>Si no recibes el correo, verifica que la dirección sea correcta</li>
                            </ul>
                        </div>

                        <div class="text-center">
                            <p class="mb-2">
                                <a asp-action="Login" class="btn btn-primary">Ir al Login</a>
                            </p>
                            <p class="mb-0">
                                <a asp-action="ForgotPassword" class="text-primary text-decoration-none">Enviar otro enlace</a>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted">Tu información está protegida y segura</small>
                </div>

            </div>
        </div>
    </div>
</body>
</html>