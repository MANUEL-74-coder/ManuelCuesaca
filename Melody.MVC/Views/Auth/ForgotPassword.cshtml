@model Melody.Modelos.DTOs.ForgotPasswordDto

@{
    ViewData["Title"] = "Recuperar Contraseña - Melody Stream";
    Layout = null;
    var hasErrors = ViewData.ModelState.ErrorCount > 0; // Evaluar ErrorCount como variable estática
}

<html>
<head>
    <meta charset="utf-8" />
    <title>Recuperar Contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Auth.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-header text-center bg-primary text-white">
                        <h3>Melody Stream</h3>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-info" role="alert">
                            <small>Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</small>
                        </div>
                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()
                            <!-- Mensajes de error generales -->
                            <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display: @(hasErrors ? "block" : "none")"></div>
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label">Correo Electrónico</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="tu@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">Enviar Enlace</button>
                            </div>
                        </form>
                        <div class="text-center">
                            <p class="mb-2">
                                <a asp-action="Login" class="text-primary text-decoration-none">Volver al Login</a>
                            </p>
                            <p class="mb-0">
                                ¿No tienes cuenta?
                                <a asp-action="Registro" class="text-primary text-decoration-none">Regístrate aquí</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}