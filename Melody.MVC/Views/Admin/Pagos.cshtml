@model IEnumerable<Melody.Modelos.Pago>
@{
    ViewData["Title"] = "Administrar Pagos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>@ViewData["Title"]</h2>
            </div>

            <!-- Estadísticas arriba -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Total Pagos</h5>
                            <h3 class="text-primary">@Model.Count()</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Ingresos Totales</h5>
                            <h3 class="text-success">$@Model.Sum(p => p.Monto).ToString("F2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Este Mes</h5>
                            <h3 class="text-info">@Model.Count(p => p.FechaPago.Month == DateTime.Now.Month && p.FechaPago.Year == DateTime.Now.Year)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">PayPal</h5>
                            <h3 class="text-warning">@Model.Count(p => p.MetodoPago == "PayPal")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buscador simple -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" action="@Url.Action("BuscarPagos")">
                        <div class="row">
                            <div class="col-md-8">
                                <input type="text"
                                       name="q"
                                       class="form-control"
                                       placeholder="Buscar por email, nombre, método de pago o plan..."
                                       value="@ViewBag.TerminoBusqueda">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary">🔍 Buscar</button>
                                @if (!string.IsNullOrWhiteSpace(ViewBag.TerminoBusqueda as string))
                                {
                                    <a href="@Url.Action("Pagos")" class="btn btn-secondary">Limpiar</a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Fecha</th>
                                <th>Plan</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model)
                            {
                                <tr>
                                    <td><strong>#@pago.Id</strong></td>
                                    <td>
                                        @if (pago.Suscripcion?.Usuario != null)
                                        {
                                            <div>
                                                <strong>@pago.Suscripcion.Usuario.Nombre @pago.Suscripcion.Usuario.Apellido</strong>
                                                <br>
                                                <small class="text-muted">@pago.Suscripcion.Usuario.Email</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            @pago.FechaPago.ToString("dd/MM/yyyy")
                                            <br>
                                            <small class="text-muted">@pago.FechaPago.ToString("HH:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        @if (pago.Suscripcion?.Plan != null)
                                        {
                                            <span class="badge bg-primary">@pago.Suscripcion.Plan.Nombre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="text-success">$@pago.Monto.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@pago.MetodoPago</span>
                                    </td>
                                    <td>
                                        @if (pago.Suscripcion != null)
                                        {
                                            @if (pago.Suscripcion.EsActiva)
                                            {
                                                <span class="badge bg-success">✅ Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">❌ Inactiva</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                              <a href="@Url.Action("DescargarPDF", "Pagos", new { pagoId = pago.Id })"
                                                    class="btn btn-outline-success btn-sm">
                                                        📄 PDF
                                              </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.TerminoBusqueda as string))
                    {
                        <h4>No se encontraron pagos</h4>
                        <p class="text-muted">No hay resultados para: "@ViewBag.TerminoBusqueda"</p>
                        <a href="@Url.Action("Pagos")" class="btn btn-primary">Ver todos</a>
                    }
                    else
                    {
                        <h4>No hay pagos registrados</h4>
                        <p class="text-muted">Los pagos aparecerán aquí cuando los usuarios realicen compras.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>