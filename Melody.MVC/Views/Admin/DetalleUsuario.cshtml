@model Melody.Modelos.DTOs.UsuarioAdminDto
@{
    ViewData["Title"] = "Detalle de Usuario";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>@ViewData["Title"]</h2>
                <a href="@Url.Action("Usuarios")" class="btn btn-secondary">
                    ← Volver a Usuarios
                </a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <!-- Información del Usuario -->
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5>Información Personal</h5>
                        </div>
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
                            {
                                <img src="@Model.FotoPerfil"
                                     alt="Foto de perfil"
                                     class="rounded-circle mb-3"
                                     style="width: 120px; height: 120px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-3 mx-auto"
                                     style="width: 120px; height: 120px; color: white; font-size: 48px;">
                                    @Model.Nombre.Substring(0, 1).ToUpper()
                                </div>
                            }

                            <h4>@Model.Nombre @Model.Apellido</h4>
                            <p class="text-muted">ID: #@Model.Id</p>

                            <div class="mb-3">
                                @foreach (string rol in Model.Roles)
                                {
                                    @if (rol == "admin")
                                    {
                                        <span class="badge bg-danger me-1">👑 Admin</span>
                                    }
                                    else if (rol == "userpremium")
                                    {
                                        <span class="badge bg-success me-1">⭐ Premium</span>
                                    }
                                    else if (rol == "userfree")
                                    {
                                        <span class="badge bg-secondary me-1">🆓 Free</span>
                                    }
                                    else if (rol == "artista")
                                    {
                                        <span class="badge bg-purple me-1">🎵 Artista</span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5>Detalles de Cuenta</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p>
                                        <strong>Email:</strong><br>
                                        @Model.Email
                                        @if (Model.EmailConfirmed)
                                        {
                                            <span class="badge bg-success ms-2">✓ Verificado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning ms-2">⚠️ Pendiente</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p>
                                        <strong>Fecha de Registro:</strong><br>
                                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <p>
                                        <strong>Estado de Email:</strong><br>
                                        @if (Model.EmailConfirmed)
                                        {
                                            <span class="text-success">✅ Email confirmado</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">⚠️ Email pendiente de confirmación</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p>
                                        <strong>Roles del Sistema:</strong><br>
                                        @string.Join(", ", Model.Roles)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acciones de Administrador -->
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>Acciones de Administrador</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                @if (!Model.EmailConfirmed)
                                {
                                    <form asp-action="ActivarEmail" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-success"
                                                onclick="return confirm('¿Estás seguro de activar el email de este usuario?')">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Activar Email
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-success" disabled>
                                        <i class="fas fa-check-circle me-1"></i>
                                        Email Ya Activado
                                    </button>
                                }

                                @* ✅ SOLO MOSTRAR ELIMINAR SI NO ES ADMIN NI ARTISTA *@
                                @if (!Model.Roles.Contains("admin") && !Model.Roles.Contains("artista"))
                                {
                                    <form asp-action="EliminarUsuario" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-danger"
                                                onclick="return confirm('¿Estás seguro de eliminar este usuario? Esta acción no se puede deshacer.')">
                                            <i class="fas fa-trash me-1"></i>
                                            Eliminar Usuario
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger" disabled title="No se pueden eliminar usuarios Admin o Artistas">
                                        <i class="fas fa-shield-alt me-1"></i>
                                        Usuario Protegido
                                    </button>
                                }
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    @if (Model.Roles.Contains("admin") || Model.Roles.Contains("artista"))
                                    {
                                        <span>Los usuarios Admin y Artistas están protegidos contra eliminación.</span>
                                    }
                                    else
                                    {
                                        <span>Estas acciones son irreversibles. Por favor, confirma antes de proceder.</span>
                                    }
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Historial de Suscripciones -->
            @if (Model.Suscripciones != null && Model.Suscripciones.Any())
            {
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h5>Historial de Suscripciones (@Model.Suscripciones.Count)</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Plan</th>
                                                <th>Inicio</th>
                                                <th>Fin</th>
                                                <th>Precio</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var suscripcion in Model.Suscripciones)
                                            {
                                                <tr class="@(suscripcion.EsActiva ? "table-success" : "")">
                                                    <td><strong>#@suscripcion.Id</strong></td>
                                                    <td>
                                                        <span class="badge bg-primary">@suscripcion.PlanNombre</span>
                                                        <br>
                                                        <small class="text-muted">@suscripcion.PlanNumeroUsuarios usuarios</small>
                                                    </td>
                                                    <td>@suscripcion.FechaInicio.ToString("dd/MM/yyyy")</td>
                                                    <td>@suscripcion.FechaFin.ToString("dd/MM/yyyy")</td>
                                                    <td><strong>$@suscripcion.PlanPrecio.ToString("F2")</strong></td>
                                                    <td>
                                                        @if (suscripcion.EsActiva)
                                                        {
                                                            <span class="badge bg-success">✅ Activa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">❌ Finalizada</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Resumen de suscripciones -->
                                <div class="row mt-3">
                                    <div class="col-md-4">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h6 class="card-title">Total Suscripciones</h6>
                                                <h4 class="text-primary">@Model.Suscripciones.Count</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h6 class="card-title">Activas</h6>
                                                <h4 class="text-success">@Model.Suscripciones.Count(s => s.EsActiva)</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h6 class="card-title">Total Gastado</h6>
                                                <h4 class="text-info">$@Model.Suscripciones.Sum(s => s.PlanPrecio).ToString("F2")</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body text-center">
                                <h5>Sin Historial de Suscripciones</h5>
                                <p class="text-muted">Este usuario no ha tenido suscripciones premium.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>