@model Melody.Modelos.Plan

@{
    ViewData["Title"] = "Eliminar Plan";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    🗑️ Eliminar Plan
                </h1>
                <a asp-action="Index" class="btn btn-secondary">
                    ⬅️ Volver a la lista
                </a>
            </div>

            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">
                        ⚠️ Confirmación de Eliminación
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        ⚠️ <strong>¡Atención!</strong> ¿Está seguro de que desea eliminar este plan? Esta acción no se puede deshacer y afectará las suscripciones asociadas.
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">ID:</label>
                                <p class="form-control-plaintext">@Model?.Id</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Nombre:</label>
                                <p class="form-control-plaintext fs-5 fw-medium">@Model?.Nombre</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Precio:</label>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-success fs-6">$@Model?.Precio</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Duración:</label>
                                <p class="form-control-plaintext">@Model?.DuracionDias días</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Usuarios:</label>
                                <p class="form-control-plaintext">@Model?.NumeroUsuarios usuarios</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Descripción:</label>
                                <p class="form-control-plaintext">@Model?.Descripcion</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" class="d-inline">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <button type="submit" class="btn btn-danger btn-lg me-2"
                                    onclick="return confirm('¿Está completamente seguro de eliminar este plan?')">
                                🗑️ Sí, Eliminar Plan
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                ❌ Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>