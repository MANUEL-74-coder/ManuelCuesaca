@model List<Melody.Modelos.Plan>
@{
    ViewData["Title"] = "Planes Premium";
}


@if (TempData["Success"] != null)
{
    <div class="alert success-alert">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert error-alert">@TempData["Error"]</div>
}

<div class="planes-index">
    @if (User.IsInRole("admin"))
    {
        <div class="admin-panel">
            <h3>Panel de Administración</h3>
            <div class="admin-stats">
                <div class="stat-card">
                    <span class="stat-number">@Model.Count</span>
                    <span class="stat-label">Planes Activos</span>
                </div>
                <div class="stat-actions">
                    <a href="@Url.Action("Create")" class="admin-btn">+ Crear Plan</a>
                    <a href="@Url.Action("Estadisticas", "Admin")" class="admin-btn secondary">📊 Estadísticas</a>
                </div>
            </div>
        </div>
    }

    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Elige tu Plan Premium</h1>
            <p class="hero-subtitle">Desbloquea todas las funciones de Melody</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="planes-grid">
            @foreach (var plan in Model)
            {
                <div class="plan-card @(plan.Nombre.ToLower().Contains("premium") ? "plan-popular" : "")">
                    @if (plan.Nombre.ToString().ToLower().Contains("premium"))
                    {
                        <div class="plan-badge">Más Popular</div>
                    }

                    <div class="plan-header">
                        <h3 class="plan-name">@plan.Nombre</h3>
                        <div class="plan-price">
                            <span class="price">$@plan.Precio</span>
                            <span class="period">@plan.DuracionDias días</span>
                        </div>
                    </div>

                    <div class="plan-features">
                        <p class="plan-description">@plan.Descripcion</p>
                    </div>

                    <div class="plan-actions">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("userpremium"))
                            {
                                <div class="premium-status">
                                    <span class="status-text">✅ Ya tienes acceso Premium</span>
                                </div>
                            }
                            else if (User.IsInRole("userfree"))
                            {
                                <form asp-controller="Pagos" asp-action="CrearOrden" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="planId" value="@plan.Id" />
                                    <button type="submit" class="subscribe-btn">Suscribirse</button>
                                </form>
                            }
                            @* Admin y artista no ven nada en esta sección *@
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Auth")" class="subscribe-btn">Iniciar Sesión</a>
                        }

                        @if (User.IsInRole("admin"))
                        {
                            <div class="admin-actions">
                                <a href="@Url.Action("Edit", new { id = plan.Id })" class="admin-link">Editar</a>
                                <a href="@Url.Action("Delete", new { id = plan.Id })" class="admin-link">Eliminar</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No hay planes disponibles</h3>
            <p>Los planes premium estarán disponibles pronto</p>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/planes.css" asp-append-version="true" />
}