@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Canciones";
    var isArtist = false;
    if (ViewBag.CurrentUser != null)
    {
        var roles = ViewBag.CurrentUser.Roles as List<string>; // Intentar castear a List<string>
        isArtist = roles != null && roles.Contains("artista");
    }
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Canciones</h2>

        @if (isArtist)
        {
            <div class="d-flex gap-2">
                <a href="@Url.Action("Create")" class="btn btn-primary">Subir Canción</a>
                <a href="@Url.Action("MisCanciones")" class="btn btn-primary">Mis Canciones</a>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var cancion in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(cancion.PortadaUrl?.ToString()))
                        {
                            <img src="@cancion.PortadaUrl.ToString()" class="card-img-top" alt="@cancion.Titulo?.ToString()" style="height: 300px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                                <span class="text-muted">Sin portada</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <a href="@Url.Action("Details", new { id = cancion.Id?.ToString(), autoplay = true })">
                                <h5 class="card-title text-dark">@cancion.Titulo?.ToString()</h5>
                            </a>
                            <p>@cancion.ArtistaNombre?.ToString()</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No hay canciones disponibles</h4>
            <p>Aún no se han subido canciones a la plataforma.</p>
        </div>
    }
</div>