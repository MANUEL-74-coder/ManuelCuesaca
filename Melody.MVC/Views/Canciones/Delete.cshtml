@model Melody.Modelos.DTOs.CancionDto
@{
    ViewData["Title"] = "Eliminar Canción";
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🗑️ Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>¿Estás seguro de que deseas eliminar esta canción?</strong>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <img src="@Model.PortadaUrl" alt="Portada de @Model.Titulo" class="img-fluid rounded">
                        </div>
                        <div class="col-md-8">
                            <h5 class="card-title">@Model.Titulo</h5>
                            <p class="card-text">
                                <strong>Artista:</strong> @Model.ArtistaNombre<br>
                                @if (!string.IsNullOrEmpty(Model.GeneroNombre))
                                {
                                    <strong>Género:</strong> @Model.GeneroNombre

                                    <br>
                                }
                                @if (!string.IsNullOrEmpty(Model.AlbumNombre))
                                {
                                    <strong>Álbum:</strong> @Model.AlbumNombre

                                    <br>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("MisCanciones")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Eliminar Canción
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>