@model IEnumerable<Melody.Modelos.DTOs.CancionDto>
@{
    ViewData["Title"] = "Buscar Canciones";
}
<div class="canciones-index">
    <div class="search-header">
        <h2>Resultados de Búsqueda</h2>
        @if (!string.IsNullOrEmpty(ViewBag.TerminoBusqueda))
        {
            <p class="search-term">Para: "<strong>@ViewBag.TerminoBusqueda</strong>"</p>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="canciones-grid">
            @foreach (var cancion in Model)
            {
                <div class="cancion-card">
                    <div class="card-image">
                        <img src="@cancion.PortadaUrl" alt="@cancion.Titulo">
                    </div>
                    <div class="card-content">
                        <a href="@Url.Action("Details", new { id = cancion.Id })" class="card-title">@cancion.Titulo</a>
                        <p class="card-artist">@cancion.ArtistaNombre</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h4>Sin resultados</h4>
            @if (!string.IsNullOrEmpty(ViewBag.TerminoBusqueda))
            {
                <p>No hay canciones para "@ViewBag.TerminoBusqueda"</p>
            }
            else
            {
                <p>Intenta con otros términos de búsqueda</p>
            }
            <a href="@Url.Action("Index")" class="back-link">Ver todas las canciones</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/canciones.css" asp-append-version="true" />
}