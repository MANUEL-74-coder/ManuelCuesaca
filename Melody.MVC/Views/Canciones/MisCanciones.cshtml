@model List<Melody.Modelos.DTOs.CancionDto>
@using Melody.Modelos
@{
    ViewData["Title"] = "Mis Canciones";
}

<div class="mis-canciones">
    <div class="page-header">
        <h2>Mis Canciones</h2>
        <a href="@Url.Action("Create")" class="primary-button">Subir Nueva Canción</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert success-alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error-alert">
            @TempData["Error"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="canciones-list">
            @foreach (var cancion in Model)
            {
                <div class="cancion-item">
                    <div class="cancion-image">
                        @if (!string.IsNullOrEmpty((string)cancion.PortadaUrl))
                        {
                            <img src="@cancion.PortadaUrl" alt="@cancion.Titulo">
                        }
                        else
                        {
                            <div class="no-image">🎵</div>
                        }
                    </div>

                    <div class="cancion-info">
                        <a href="@Url.Action("Details", new { id = cancion.Id })" class="cancion-title">@cancion.Titulo</a>
                        <p class="cancion-details">
                            <strong>Género:</strong> @cancion.GeneroNombre
                            @if (!string.IsNullOrEmpty((string)cancion.AlbumNombre) && cancion.AlbumNombre != "Sin Álbum")
                            {
                                <span> • <strong>Álbum:</strong> @cancion.AlbumNombre</span>
                            }
                            else
                            {
                                <span> • Sin álbum</span>
                            }
                        </p>

                        @if (string.IsNullOrEmpty((string)cancion.AlbumNombre) || cancion.AlbumNombre == "Sin Álbum")
                        {
                            <form method="post" action="@Url.Action("AgregarAAlbum")" class="album-form">
                                <input type="hidden" name="cancionId" value="@cancion.Id" />
                                <div class="form-group">
                                    <select name="albumId" class="form-select" required>
                                        <option value="">Seleccionar álbum...</option>
                                        @foreach (var album in ViewBag.MisAlbums as List<Album>)
                                        {
                                            <option value="@album.Id">@album.Titulo</option>
                                        }
                                    </select>
                                    <button type="submit" class="add-button">+ Agregar</button>
                                </div>
                            </form>
                        }
                    </div>

                    <div class="cancion-actions">
                        <a href="@Url.Action("Edit", new { id = cancion.Id })" class="edit-button">Editar</a>
                        <a href="@Url.Action("ConfirmarDelete", new { id = cancion.Id })" class="delete-button">Eliminar</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h4>No tienes canciones subidas</h4>
            <p>¡Comparte tu música con el mundo!</p>
            <a href="@Url.Action("Create")" class="primary-button">Subir mi primera canción</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/canciones.css" asp-append-version="true" />
}