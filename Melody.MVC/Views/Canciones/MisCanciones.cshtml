@model List<Melody.Modelos.DTOs.CancionDto>

@{
    ViewData["Title"] = "Mis Canciones";
    var successMessage = TempData["Success"] as string; // Capturar Success como variable estática
    var errorMessage = TempData["Error"] as string; // Capturar Error como variable estática
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mis Canciones</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">Subir Nueva Canción</a>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var cancion in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(cancion.PortadaUrl)) // Eliminar cast innecesario
                        {
                            <img src="@cancion.PortadaUrl" class="card-img-top" alt="@cancion.Titulo">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <span class="text-muted">Sin portada</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <a href="@Url.Action("Details", new { id = cancion.Id })" class="text-decoration-none">
                                <h5 class="card-title text-dark">@cancion.Titulo</h5>
                            </a>
                            <p class="card-text">
                                <small>Género: @cancion.GeneroNombre</small><br>
                                @if (!string.IsNullOrEmpty(cancion.AlbumNombre) && cancion.AlbumNombre != "Sin Álbum")
                                {
                                    <small class="text-muted">Álbum: @cancion.AlbumNombre</small>
                                    <br>
                                }
                            </p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between">
                                    <a href="@Url.Action("Edit", new { id = cancion.Id })" class="btn btn-warning btn-sm">Editar</a>
                                    <a href="@Url.Action("ConfirmarDelete", new { id = cancion.Id })" class="btn btn-danger btn-sm">Eliminar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No tienes canciones subidas</h4>
            <p>Aún no has subido ninguna canción. ¡Comparte tu música con el mundo!</p>
            <a href="@Url.Action("Create")" class="btn btn-primary">Subir mi primera canción</a>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Ver todas las canciones</a>
    </div>
</div>