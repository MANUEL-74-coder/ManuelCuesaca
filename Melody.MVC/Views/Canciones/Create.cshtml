@model Melody.Modelos.DTOs.CancionCrearDto
@{
    ViewData["Title"] = "Subir Canción";
}

<div class="cancion-container">
    <div class="page-header">
        <h1>🎤 Subir Nueva Canción</h1>
        <a href="@Url.Action("MisCanciones")" class="secondary-button">⬅️ Volver a Mis Canciones</a>
    </div>

    <div class="cancion-form">
        <div class="form-card">
            <h4>🎵 Nueva Canción</h4>

            @if (TempData["Error"] != null)
            {
                <div class="error-alert">@TempData["Error"]</div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="error-alert"></div>

                <div class="form-field">
                    <label asp-for="Titulo">Título de la Canción *</label>
                    <input asp-for="Titulo" class="form-input" placeholder="Ingresa el título de tu canción">
                    <span asp-validation-for="Titulo" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ArchivoAudio">Archivo de Audio *</label>
                    <input asp-for="ArchivoAudio" type="file" class="form-file" accept=".mp3,.wav,.flac">
                    <span asp-validation-for="ArchivoAudio" class="field-error"></span>
                    <small class="field-help">Formatos: MP3, WAV, FLAC</small>
                </div>

                <div class="form-field">
                    <label asp-for="ImagenPortada">Imagen de Portada (Opcional)</label>
                    <input asp-for="ImagenPortada" type="file" class="form-file" accept="image/*">
                    <span asp-validation-for="ImagenPortada" class="field-error"></span>
                    <small class="field-help">JPG, PNG - Máximo 5MB</small>
                </div>

                <div class="form-field">
                    <label asp-for="GeneroId">Género *</label>
                    <select asp-for="GeneroId" class="form-select" asp-items="ViewBag.Generos">
                        <option value="">Selecciona un género</option>
                    </select>
                    <span asp-validation-for="GeneroId" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="AlbumId">Álbum (Opcional)</label>
                    <select asp-for="AlbumId" class="form-select" asp-items="ViewBag.Albums">
                        <option value="">Sin álbum</option>
                    </select>
                    <span asp-validation-for="AlbumId" class="field-error"></span>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("MisCanciones")" class="secondary-button">❌ Cancelar</a>
                    <button type="submit" class="primary-button">🎤 Subir Canción</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
	<link rel="stylesheet" href="~/css/canciones.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}