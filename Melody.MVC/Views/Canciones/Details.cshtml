@model Melody.Modelos.DTOs.CancionDto

@{
    ViewData["Title"] = Model.Titulo;
    var artista = ViewBag.Artista as Melody.Modelos.DTOs.ArtistaDto;
    var canciones = artista?.Canciones ?? new List<Melody.Modelos.DTOs.CancionDto>(); // Asegurar valor por defecto
}

<div class="container-fluid">
    <!-- Header principal de la canción -->
    <div class="d-flex align-items-end gap-3 my-4">
        <img src="@(string.IsNullOrEmpty(Model.PortadaUrl) ? "/images/default-song.png" : Model.PortadaUrl)"
             alt="@Model.Titulo" width="200" height="200" class="rounded shadow">
        <div>
            <p>CANCIÓN</p>
            <h1 class="display-4 fw-bold mb-2">@Model.Titulo</h1>
            <div class="d-flex align-items-center gap-2 mb-3">
                <img src="@(string.IsNullOrEmpty(artista?.ImagenPerfil) ? "/images/default-artist.png" : artista.ImagenPerfil)"
                     alt="@artista?.NombreArtista" width="24" height="24" class="rounded-circle">
                <a href="/Artistas/Details/@Model.ArtistaId" class="text-decoration-none fw-bold">@Model.ArtistaNombre</a>
                <span>•</span>
                <span>@Model.AlbumNombre</span>
                <span>@Model.FechaLanzamiento.Year</span>
                <span>•</span>
                <span>@(Model.Duracion?.ToString(@"m\:ss") ?? "0:00")</span>
            </div>
        </div>
    </div>

    <!-- Controles de reproducción -->
    <div class="mb-4">
        <button onclick="playAllSongs()" class="btn btn-success btn-lg rounded-pill px-4">
            ▶️ Reproducir Todo
        </button>
    </div>

    <!-- Lista de canciones del artista -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-center">#</th>
                    <th scope="col">Portada</th>
                    <th scope="col">Título</th>
                    <th scope="col">Álbum</th>
                    <th scope="col" class="text-center">Duración</th>
                    <th scope="col" class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < canciones.Count; i++)
                {
                    var cancion = canciones[i];
                    <tr class="@(cancion.Id == Model.Id ? "table-info" : "")">
                        <td class="text-center">@(i + 1)</td>
                        <td>
                            <img src="@(string.IsNullOrEmpty(cancion.PortadaUrl) ? "/images/default-song.png" : cancion.PortadaUrl)"
                                 alt="@cancion.Titulo" width="40" height="40" class="rounded">
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Canciones", new { id = cancion.Id })"
                               class="text-decoration-none text-primary fw-bold">
                                @cancion.Titulo
                            </a><br>
                            <span>@cancion.ArtistaNombre</span>
                        </td>
                        <td>@cancion.AlbumNombre</td>
                        <td class="text-center">
                            @(cancion.Duracion?.ToString(@"m\:ss") ?? "0:00")
                        </td>
                        <td class="text-center">
                            <button onclick="playSong('@cancion.ArchivoAudioUrl', '@cancion.Titulo', '@cancion.ArtistaNombre', '@cancion.PortadaUrl', @cancion.Id)"
                                    class="btn btn-success btn-sm">
                                ▶️ Reproducir
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function playSong(audioUrl, title, artist, coverUrl, id) {
        // Lógica para reproducir la canción
        console.log(`Reproduciendo: ${title} por ${artist}`);
    }

    function playAllSongs() {
        // Lógica para reproducir todas las canciones
        console.log("Reproduciendo todas las canciones");
    }
</script>