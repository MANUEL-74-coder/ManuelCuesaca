@model Melody.Modelos.DTOs.MiSuscripcionResponseDto
@{
    ViewData["Title"] = "Cancelar Suscripción";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark text-center">
                    <h4><i class="fas fa-exclamation-triangle"></i> Cancelar Suscripción</h4>
                </div>
                <div class="card-body">
                    @if (Model.Suscripcion != null)
                    {
                        <div class="alert alert-info">
                            <h6>Información de tu suscripción:</h6>
                            <ul class="mb-0">
                                <li><strong>Plan:</strong> @Model.Suscripcion.PlanNombre</li>
                                <li><strong>Precio:</strong> $@Model.Suscripcion.PlanPrecio</li>
                                <li><strong>Válida hasta:</strong> @Model.Suscripcion.FechaFin.ToString("dd/MM/yyyy")</li>
                                @if (Model.Suscripcion.TotalUsuarios > 1)
                                {
                                    <li><strong>Usuarios activos:</strong> @Model.Suscripcion.TotalUsuarios</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="alert alert-warning">
                        <h6><i class="fas fa-warning"></i> ¿Estás seguro?</h6>
                        <p class="mb-1">Al cancelar tu suscripción:</p>
                        <ul class="mb-0">
                            <li>Perderás el acceso premium <strong>inmediatamente</strong></li>
                            <li>No podrás gestionar playlists avanzadas</li>
                            <li>Se limitarán las funciones de descarga</li>
                            @if (Model.Suscripcion?.TotalUsuarios > 1)
                            {
                                <li><strong>Todos los miembros familiares</strong> también perderán el acceso</li>
                            }
                        </ul>
                    </div>

                    <div class="d-grid gap-2">
                        <form asp-action="Cancelar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="suscripcionId" value="@Model.Suscripcion.Id" />
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-times"></i> Sí, Cancelar Mi Suscripción
                            </button>
                        </form>

                        <a asp-action="MisSuscripciones" class="btn btn-success btn-lg">
                            <i class="fas fa-arrow-left"></i> No, Mantener Suscripción
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            ¿Problemas con tu suscripción?
                            <a href="#" class="text-decoration-none">Contacta soporte</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>