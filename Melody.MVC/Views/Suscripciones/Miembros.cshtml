@model Melody.Modelos.DTOs.MiembrosFamiliaResponseDto
@{
    ViewData["Title"] = "Gestión de Usuarios Adicionales";
    var suscripcionId = ViewBag.SuscripcionId;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>@ViewData["Title"]</h2>
                <a href="@Url.Action("MiSuscripcion")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Mi Suscripción
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Estadísticas de uso -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-center bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Usuarios</h5>
                            <h3>@Model.TotalUsuarios</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Usuarios Adicionales</h5>
                            <h3>@Model.Miembros.Count</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center bg-warning text-dark">
                        <div class="card-body">
                            <h5 class="card-title">Espacios Libres</h5>
                            <h3>@Model.EspaciosDisponibles</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Puede Agregar</h5>
                            <h3>@(Model.PuedeAgregarMas ? "Sí" : "No")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Propietario de la suscripción -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-crown text-warning"></i>
                        Propietario Principal
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="fas fa-user-circle fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">@Model.UsuarioPrincipalNombre</h6>
                            <small class="text-muted">@Model.UsuarioPrincipalEmail</small>
                            <div>
                                <span class="badge bg-primary">Propietario</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.PuedeAgregarMas)
            {
                <!-- Formulario para agregar usuario -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-user-plus text-success"></i>
                            Agregar Usuario
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="post" action="@Url.Action("AgregarMiembro")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="suscripcionId" value="@suscripcionId" />
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <label for="email" class="form-label">Email del usuario</label>
                                    <input type="email" class="form-control" id="email" name="email"
                                           placeholder="ejemplo@correo.com" required>
                                    <div class="form-text">
                                        <i class="fas fa-info-circle text-info"></i>
                                        El usuario debe tener una cuenta registrada en la plataforma
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-plus"></i> Agregar Usuario
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Límite alcanzado:</strong> Has utilizado todos los espacios disponibles en tu plan.
                </div>
            }

            <!-- Lista de usuarios adicionales -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-users text-info"></i>
                        Usuarios Adicionales (@Model.Miembros.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Miembros.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Email</th>
                                        <th>Fecha de Unión</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var miembro in Model.Miembros)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-user-circle fa-lg text-secondary me-2"></i>
                                                    <div>
                                                        <strong>@miembro.Nombre @miembro.Apellido</strong>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@miembro.Email</td>
                                            <td>@miembro.FechaUnion.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <span class="badge bg-success">Activo</span>
                                            </td>
                                            <td>
                                                <a asp-action="RemoverUsuario" 
                                                   asp-route-suscripcionId="@suscripcionId"
                                                   asp-route-usuarioId="@miembro.UsuarioId"
                                                   class="btn btn-danger btn-sm">
                                                    <i class="fas fa-user-minus"></i> Remover
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h5>No hay usuarios adicionales</h5>
                            <p class="text-muted">Agrega usuarios a tu suscripción para compartir los beneficios premium.</p>
                            @if (Model.PuedeAgregarMas)
                            {
                                <p><small>Puedes agregar hasta @Model.EspaciosDisponibles usuarios más.</small></p>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("MiSuscripcion")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Mi Suscripción
                </a>
            </div>
        </div>
    </div>
</div>
