@model Melody.Modelos.DTOs.MiSuscripcionResponseDto
@{
    ViewData["Title"] = "Mi Suscripción";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-crown"></i> @ViewData["Title"]</h2>
        @if (!Model.TienesSuscripcion)
        {
            <a asp-controller="Planes" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-plus"></i> Obtener Suscripción
            </a>
        }
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.TienesSuscripcion)
    {
        <!-- Sin suscripción -->
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-star fa-3x text-muted mb-3"></i>
                <h4>No tienes una suscripción activa</h4>
                <p class="text-muted">Suscríbete para disfrutar de todas las funciones premium de Melody.</p>
                <a asp-controller="Planes" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fas fa-shopping-cart"></i> Ver Planes Disponibles
                </a>
            </div>
        </div>
    }
    else if (Model.Suscripcion != null)
    {
        <!-- Con suscripción activa -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5><i class="fas fa-check-circle"></i> Suscripción Activa</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Plan:</strong></div>
                            <div class="col-sm-8">
                                <span class="badge bg-primary fs-6">@Model.Suscripcion.PlanNombre</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Precio:</strong></div>
                            <div class="col-sm-8 text-success fw-bold">$@Model.Suscripcion.PlanPrecio</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Válida hasta:</strong></div>
                            <div class="col-sm-8">@Model.Suscripcion.FechaFin.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Días restantes:</strong></div>
                            <div class="col-sm-8">
                                @if (Model.Suscripcion.DiasRestantes > 7)
                                {
                                    <span class="badge bg-success">@Model.Suscripcion.DiasRestantes días</span>
                                }
                                else if (Model.Suscripcion.DiasRestantes > 0)
                                {
                                    <span class="badge bg-warning">@Model.Suscripcion.DiasRestantes días</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expirada</span>
                                }
                            </div>
                        </div>

                        @if (Model.EsPropietario && Model.Suscripcion.PlanNumeroUsuarios > 1)
                        {
                            <hr>
                            <h6><i class="fas fa-users"></i> Plan Familiar</h6>
                            <div class="row">
                                <div class="col-sm-4"><strong>Usuarios activos:</strong></div>
                                <div class="col-sm-8">@Model.Suscripcion.TotalUsuarios / @Model.Suscripcion.PlanNumeroUsuarios</div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4"><strong>Espacios disponibles:</strong></div>
                                <div class="col-sm-8">@Model.Suscripcion.EspaciosDisponibles</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6><i class="fas fa-cog"></i> Acciones</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.EsPropietario && Model.Suscripcion.PlanNumeroUsuarios > 1)
                        {
                            <a asp-action="Miembros" asp-route-id="@Model.Suscripcion.Id"
                               class="btn btn-outline-primary btn-sm d-grid mb-2">
                                <i class="fas fa-users"></i> Gestionar Familia
                            </a>
                        }

                        <a asp-controller="Pagos" asp-action="MisPagos"
                           class="btn btn-outline-secondary btn-sm d-grid mb-2">
                            <i class="fas fa-receipt"></i> Historial de Pagos
                        </a>

                        @if (Model.EsPropietario)
                        {
                            <hr>
                            <a asp-action="ConfirmarCancelacion" asp-route-id="@Model.Suscripcion.Id"
                               class="btn btn-outline-danger btn-sm d-grid">
                                <i class="fas fa-times"></i> Cancelar Suscripción
                            </a>
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-body text-center">
                        <h6>Estado Premium</h6>
                        <i class="fas fa-star fa-2x text-warning mb-2"></i>
                        <p class="small text-muted mb-0">
                            Disfrutas de todas las funciones premium de Melody
                        </p>
                    </div>
                </div>
            </div>
        </div>

    }
</div>