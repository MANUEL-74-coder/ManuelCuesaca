@{
    ViewData["Title"] = "Miembros Familiares";
}

<div class="container mt-4">
    <h2>Gestión de Miembros Familiares</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <!-- Usuario Principal -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5>👑 Usuario Principal</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nombre:</strong> @Model.usuarioPrincipal.Nombre @Model.usuarioPrincipal.Apellido</p>
                    <p><strong>Email:</strong> @Model.usuarioPrincipal.Email</p>
                </div>
            </div>

            <!-- Miembros Familiares -->
            <div class="card">
                <div class="card-header">
                    <h5>👥 Miembros Familiares (@(Model.miembros?.Count ?? 0))</h5>
                </div>
                <div class="card-body">
                    @if (Model.miembros != null && Model.miembros.Count > 0)
                    {
                        @foreach (var miembro in Model.miembros)
                        {
                            <div class="border-bottom py-2 mb-2">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <p class="mb-1"><strong>@miembro.Usuario.Nombre @miembro.Usuario.Apellido</strong></p>
                                        <p class="mb-1 text-muted">@miembro.Usuario.Email</p>
                                        <small class="text-muted">Unido: @DateTime.Parse(miembro.FechaUnion.ToString()).ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        @if (Model.puedeAgregarMas == true)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmarRemover(@miembro.Usuario.Id, '@miembro.Usuario.Nombre @miembro.Usuario.Apellido')">
                                                Remover
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No hay miembros familiares agregados.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Resumen -->
            <div class="card">
                <div class="card-header">
                    <h6>📊 Resumen</h6>
                </div>
                <div class="card-body">
                    <p><strong>Total Usuarios:</strong> @Model.totalUsuarios</p>
                    <p><strong>Espacios Disponibles:</strong> @Model.espaciosDisponibles</p>

                    @if (Model.espaciosDisponibles > 0 && Model.puedeAgregarMas == true)
                    {
                        <hr />
                        <h6>➕ Agregar Miembro</h6>
                        <form method="post" action="@Url.Action("AgregarMiembro")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="suscripcionId" value="@ViewBag.SuscripcionId" />

                            <div class="mb-3">
                                <label for="email" class="form-label">Email del usuario:</label>
                                <input type="email" class="form-control" id="email" name="email" required />
                                <small class="form-text text-muted">El usuario debe estar registrado en Melody</small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Agregar Miembro</button>
                        </form>
                    }
                    else if (Model.espaciosDisponibles <= 0)
                    {
                        <div class="alert alert-warning">
                            Has alcanzado el límite de usuarios para tu plan.
                        </div>
                    }
                </div>
            </div>

            <!-- Botón Volver -->
            <div class="mt-3">
                <a href="@Url.Action("MiSuscripcion")" class="btn btn-secondary w-100">
                    ← Volver a Mi Suscripción
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Remover -->
<div class="modal fade" id="removerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas remover a <span id="nombreMiembro"></span> de tu plan familiar?</p>
                <p class="text-warning">El usuario perderá acceso premium inmediatamente.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" action="@Url.Action("RemoverMiembro")" id="formRemover">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suscripcionId" value="@ViewBag.SuscripcionId" />
                    <input type="hidden" name="usuarioId" id="usuarioIdRemover" />
                    <button type="submit" class="btn btn-danger">Remover</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmarRemover(usuarioId, nombreCompleto) {
        document.getElementById('usuarioIdRemover').value = usuarioId;
        document.getElementById('nombreMiembro').textContent = nombreCompleto;
        new bootstrap.Modal(document.getElementById('removerModal')).show();
    }
</script>