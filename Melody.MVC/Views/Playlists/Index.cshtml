@model List<Melody.Modelos.DTOs.PlaylistDto>
@{
    ViewData["Title"] = "Playlists Públicas";
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Auth.UserSessionInfo;
}

<div class="playlists-index">
    <div class="page-header">
        <div class="header-info">
            <h2>Playlists Públicas</h2>
            <p class="subtitle">Descubre playlists creadas por otros usuarios</p>
        </div>

        @if (currentUser?.IsUserPremium == true)
        {
            <div class="header-buttons">
                <a href="@Url.Action("MisPlaylists")" class="primary-button">📋 Mis Playlists</a>
            </div>
        }
        else if (currentUser?.IsUserFree == true)
        {
            <div class="header-buttons">
                <a href="/Suscripciones" class="premium-button">⭐ Hazte Premium</a>
            </div>
        }
    </div>

    <div class="search-section">
        <form asp-action="Buscar" method="get" class="search-form">
            <input type="text" name="q" class="search-input" placeholder="Buscar playlists..." value="@ViewBag.TerminoBusqueda">
            <button type="submit" class="search-button">Buscar</button>
        </form>
    </div>

    @if (Model.Any())
    {
        <div class="playlists-grid">
            @foreach (var playlist in Model)
            {
                <div class="playlist-card">
                    <div class="card-image">
                        @if (!string.IsNullOrEmpty(playlist.Imagen))
                        {
                            <img src="@playlist.Imagen" alt="@playlist.Nombre">
                        }
                        else
                        {
                            <div class="no-image">
                                <span>🎵</span>
                            </div>
                        }
                    </div>
                    <div class="card-content">
                        <a href="@Url.Action("Details", new { id = playlist.Id })" class="card-title">@playlist.Nombre</a>
                        <p class="card-creator">Por @playlist.CreadorNombre @playlist.CreadorApellido</p>
                        <p class="card-details">@playlist.TotalCanciones canciones</p>
                        @if (playlist.DuracionTotal > 0)
                        {
                            <p class="card-details">@Math.Round(playlist.DuracionTotal, 0) min</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            @if (!string.IsNullOrEmpty(ViewBag.TerminoBusqueda as string))
            {
                <h4>No se encontraron playlists</h4>
                <p>Intenta con otros términos de búsqueda</p>
                <a href="@Url.Action("Index")" class="back-link">Ver todas las playlists</a>
            }
            else
            {
                <h4>No hay playlists públicas</h4>
                <p>Sé el primero en crear una playlist pública</p>
                @if (currentUser?.IsUserPremium == true)
                {
                    <a href="@Url.Action("Create")" class="primary-button">➕ Crear Playlist</a>
                }
                else
                {
                    <a href="/Suscripciones" class="premium-button">⭐ Hazte Premium</a>
                }
            }
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="toast-alert success-toast">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="toast-alert error-toast">
        @TempData["Error"]
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/playlist.css" asp-append-version="true" />
}