@model Melody.Modelos.DTOs.CrearPlaylistDto
@{
    ViewData["Title"] = "Crear Nueva Playlist";
}

<div class="playlist-container">
    <div class="page-header">
        <h1>✨ Crear Nueva Playlist</h1>
        <a href="@Url.Action("MisPlaylists")" class="btn btn-secondary">⬅️ Volver a Mis Playlists</a>
    </div>

    <div class="form-playlist">
        <div class="playlist-card">
            <h5>🎵 Nueva Playlist</h5>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group">
                    <label asp-for="Nombre">Nombre de la Playlist *</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingresa el nombre de tu playlist">
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Imagen">Imagen de Portada (Opcional)</label>
                    <input asp-for="Imagen" type="file" class="form-control" accept="image/*">
                    <span asp-validation-for="Imagen" class="text-danger"></span>
                    <div class="form-text">Formatos permitidos: JPG, JPEG, PNG. Máximo 5MB.</div>
                </div>

                <div class="form-group">
                    <label>Visibilidad</label>
                    <div class="visibility-options">
                        <div class="visibility-item">
                            <input asp-for="EsPublica" class="form-check-input" type="radio" value="false" checked id="privada">
                            <label for="privada" class="visibility-label">
                                <i class="fas fa-lock text-warning"></i>
                                <div>
                                    <strong>Privada</strong>
                                    <small>Solo tú puedes verla</small>
                                </div>
                            </label>
                        </div>
                        <div class="visibility-item">
                            <input asp-for="EsPublica" class="form-check-input" type="radio" value="true" id="publica">
                            <label for="publica" class="visibility-label">
                                <i class="fas fa-globe text-success"></i>
                                <div>
                                    <strong>Pública</strong>
                                    <small>Todos pueden verla</small>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("MisPlaylists")" class="btn btn-secondary">❌ Cancelar</a>
                    <button type="submit" class="btn btn-success">✨ Crear Playlist</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/playlist.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}