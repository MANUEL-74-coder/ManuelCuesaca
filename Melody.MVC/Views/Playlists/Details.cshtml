@model Melody.Modelos.DTOs.PlaylistDto
@{
    ViewData["Title"] = Model.Nombre;
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Auth.UserSessionInfo;
    var misPlaylists = ViewBag.MisPlaylists as List<Melody.Modelos.DTOs.PlaylistDto> ?? new List<Melody.Modelos.DTOs.PlaylistDto>();
    var esCreadorPlaylist = (currentUser?.UserName == Model.CreadorNombre || currentUser?.UserId == Model.CreadorId.ToString())
                           && (currentUser?.IsUserPremium == true || currentUser?.IsUserFree == true);
}

<!-- Mostrar mensajes al inicio -->
@if (TempData["Success"] != null)
{
    <div class="alert success-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert error-alert">
        @TempData["Error"]
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert warning-alert">
        @TempData["Warning"]
    </div>
}

<div class="playlist-details">
    <!-- Header de la playlist -->
    <div class="hero-section">
        <div class="hero-image">
            <img src="@(string.IsNullOrEmpty(Model.Imagen) ? "/images/default-playlist.png" : Model.Imagen)" alt="@Model.Nombre">
        </div>
        <div class="hero-info">
            <p class="content-type">PLAYLIST</p>
            <h1 class="playlist-title">@Model.Nombre</h1>
            <div class="playlist-meta">
                @if (!string.IsNullOrEmpty(Model.CreadorFotoPerfil))
                {
                    <img src="@Model.CreadorFotoPerfil" alt="@Model.CreadorNombre" class="creator-avatar">
                }
                else
                {
                    <div class="creator-avatar-letter">
                        @Model.CreadorNombre.FirstOrDefault().ToString().ToUpper()
                    </div>
                }
                <span class="creator-name">@Model.CreadorNombre @Model.CreadorApellido</span>
                <span class="separator">•</span>
                <span>@Model.TotalCanciones canciones</span>
                @if (Model.DuracionTotal > 0)
                {
                    <span class="separator">•</span>
                    <span>@Math.Round(Model.DuracionTotal, 0) min</span>
                }
                <span class="separator">•</span>
                <span class="visibility-badge @(Model.EsPublica ? "public" : "private")">
                    @(Model.EsPublica ? "🌐 Pública" : "🔒 Privada")
                </span>
            </div>
        </div>
    </div>

    <!-- Controles de reproducción -->
    @if (Model.Canciones != null && Model.Canciones.Any())
    {
        <div class="play-section">
            <button onclick="playSong('@Model.Canciones.First().ArchivoAudioUrl', '@Model.Canciones.First().CancionTitulo', '@Model.Canciones.First().ArtistaNombre', '@Model.Canciones.First().PortadaUrl', @Model.Canciones.First().CancionId)"
                    class="play-button">
                ▶️ Reproducir Playlist
            </button>
        </div>

        <!-- Lista de canciones -->
        <div class="songs-list">
            <div class="list-header @(esCreadorPlaylist ? "with-management" : "")">
                <span class="col-num">#</span>
                <span class="col-song">Título</span>
                <span class="col-artist">Artista</span>
                <span class="col-album">Álbum</span>
                <span class="col-duration">Duración</span>
                <span class="col-actions">Acciones</span>
            </div>

            @for (int i = 0; i < Model.Canciones.Count; i++)
            {
                var cancion = Model.Canciones[i];
                <div class="song-item @(esCreadorPlaylist ? "with-management" : "")">
                    <span class="song-number">@(i + 1)</span>

                    <div class="song-info">
                        <img src="@(string.IsNullOrEmpty(cancion.PortadaUrl) ? "/images/default-song.png" : cancion.PortadaUrl)"
                             alt="@cancion.CancionTitulo" class="song-image">
                        <div class="song-text">
                            <a href="@Url.Action("Details", "Canciones", new { id = cancion.CancionId })" class="song-link">
                                @cancion.CancionTitulo
                            </a>
                        </div>
                    </div>

                    <div class="song-artist">
                        <a href="@Url.Action("Details", "Artistas", new { id = cancion.ArtistaId })" class="artist-link">
                            @cancion.ArtistaNombre
                        </a>
                    </div>

                    <div class="song-album">
                        @if (!string.IsNullOrEmpty(cancion.AlbumNombre) && cancion.AlbumNombre != "Sin Álbum")
                        {
                            <a href="@Url.Action("Details", "Albums", new { id = cancion.AlbumId })" class="album-link">
                                @cancion.AlbumNombre
                            </a>
                        }
                        else
                        {
                            <span class="no-album">Sin Álbum</span>
                        }
                    </div>

                    <span class="song-duration">@(cancion.Duracion?.ToString(@"m\:ss") ?? "0:00")</span>

                    <div class="song-actions">
                        <!-- Botón reproducir -->
                        <button onclick="playSong('@cancion.ArchivoAudioUrl', '@cancion.CancionTitulo', '@cancion.ArtistaNombre', '@cancion.PortadaUrl', @cancion.CancionId)"
                                class="action-btn play-btn" title="Reproducir">
                            ▶️
                        </button>

                        <!-- Botón me gusta -->
                        @if (currentUser != null && (currentUser.IsUserFree || currentUser.IsUserPremium))
                        {
                            <button type="button" onclick="toggleMeGusta(@cancion.CancionId, this)"
                                    class="action-btn favorite-btn"
                                    data-cancion-id="@cancion.CancionId"
                                    data-es-favorito="@cancion.EsFavorito.ToString().ToLower()"
                                    title="@(cancion.EsFavorito ? "Quitar de favoritos" : "Agregar a favoritos")">
                                @(cancion.EsFavorito ? "♥" : "♡")
                            </button>
                        }

                        <!-- Agregar a playlist -->
                        @if (currentUser?.IsUserPremium == true && misPlaylists.Any())
                        {
                            <div class="dropdown">
                                <button class="action-btn add-btn dropdown-toggle"
                                        data-bs-toggle="dropdown" title="Agregar a playlist">
                                    ➕
                                </button>
                                <ul class="dropdown-menu">
                                    @foreach (var playlist in misPlaylists.Where(p => p.Id != Model.Id))
                                    {
                                        <li>
                                            <form asp-controller="Canciones" asp-action="AgregarAPlaylist" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cancionId" value="@cancion.CancionId" />
                                                <input type="hidden" name="playlistId" value="@playlist.Id" />
                                                <button type="submit" class="dropdown-item">📋 @playlist.Nombre</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else if (currentUser?.IsUserFree == true)
                        {
                            <a href="/Suscripciones" class="action-btn premium-btn" title="Hazte Premium">⭐</a>
                        }

                        <!-- Botón eliminar -->
                        @if (esCreadorPlaylist)
                        {
                            <form asp-action="EliminarCancion" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="playlistCancionId" value="@cancion.PlaylistCancionId" />
                                <input type="hidden" name="playlistId" value="@Model.Id" />
                                <button type="submit" class="action-btn remove-btn"
                                        title="Eliminar de playlist"
                                        onclick="return confirm('¿Quitar esta canción de la playlist?')">
                                    ❌
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Estado vacío -->
        <div class="empty-state">
            <div class="empty-icon">🎵</div>
            <h4>Esta playlist está vacía</h4>
            <p>Agrega canciones desde los detalles de las canciones</p>
            <a href="@Url.Action("Index", "Canciones")" class="explore-btn">
                Explorar Música
            </a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/playlist.css" asp-append-version="true" />
}