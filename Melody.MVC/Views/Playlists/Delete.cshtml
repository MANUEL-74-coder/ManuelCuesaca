@model Melody.Modelos.DTOs.PlaylistDto
@{
    ViewData["Title"] = "Eliminar Playlist";
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Confirmar Eliminación</h4>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.Imagen))
                    {
                        <img src="@Model.Imagen" alt="@Model.Nombre" width="150" height="150" class="mb-3 rounded">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center mb-3 rounded" style="width: 150px; height: 150px; margin: 0 auto;">
                            <span style="font-size: 3rem;">🎵</span>
                        </div>
                    }
                    <h5>@Model.Nombre</h5>
                    <p class="text-muted">Por: @Model.CreadorNombre @Model.CreadorApellido</p>
                    <p class="text-muted">@Model.TotalCanciones cancion(es)</p>
                    <p class="text-muted">
                        <span class="badge @(Model.EsPublica ? "bg-success" : "bg-secondary")">
                            @(Model.EsPublica ? "Pública" : "Privada")
                        </span>
                    </p>
                    <div class="alert alert-warning">
                        <strong>¿Estás seguro de que deseas eliminar esta playlist?</strong>
                        <br>Esta acción no se puede deshacer.
                    </div>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("MisPlaylists")" class="btn btn-secondary">❌ Cancelar</a>
                        <form method="post" asp-action="Delete" style="display: inline;">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger">🗑️ Sí, eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>