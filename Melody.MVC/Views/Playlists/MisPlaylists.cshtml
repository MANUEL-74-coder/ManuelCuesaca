@model IEnumerable<Melody.Modelos.DTOs.PlaylistDto>
@{
    ViewData["Title"] = "Mis Playlists";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Mis Playlists</h2>
                    <p>
                        <a asp-action="Create" class="btn btn-primary">Crear nueva Playlist</a>
                    </p>
                </div>
            </div>

            <!-- Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Any())
            {
                <!-- Lista de playlists -->
                <div class="playlists-list">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex align-items-center py-3 border-bottom">
                            <!-- Imagen de la playlist -->
                            <div class="me-3">
                                @if (!string.IsNullOrEmpty(item.Imagen))
                                {
                                    <img src="@item.Imagen"
                                         alt="@item.Nombre"
                                         class="rounded"
                                         style="width: 68px; height: 68px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center"
                                         style="width: 68px; height: 68px;">
                                        <i class="fas fa-music text-white"></i>
                                    </div>
                                }
                            </div>

                            <!-- Información de la playlist -->
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    <h5 class="mb-0 me-2">@item.Nombre</h5>
                                    <span class="badge @(item.EsPublica ? "bg-success" : "bg-secondary") ms-2">
                                        @(item.EsPublica ? "Pública" : "Privada")
                                    </span>
                                </div>

                                <p class="text-muted mb-1">
                                    <strong>@item.CreadorNombre @item.CreadorApellido</strong> •
                                    <span class="text-info">@item.TotalCanciones cancion(es)</span>
                                    @if (item.DuracionTotal > 0)
                                    {
                                        <span> • @Math.Round(item.DuracionTotal, 0) min</span>
                                    }
                                </p>
                            </div>

                            <!-- Acciones -->
                            <div class="ms-3">
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                       class="btn btn-outline-info btn-sm">
                                        Details
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                       class="btn btn-outline-warning btn-sm">
                                        Edit
                                    </a>
                                    <a href="@Url.Action("ConfirmarDelete", new { id = item.Id })"
                                       class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4 class="text-muted">No tienes playlists aún</h4>
                    <p class="text-muted">Crea tu primera playlist para comenzar</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">Crear nueva Playlist</a>
                </div>
            }
        </div>
    </div>
</div>