@model List<Melody.Modelos.DTOs.PlaylistDto>
@{
    ViewData["Title"] = "Mis Playlists";
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Auth.UserSessionInfo;
    var totalPlaylists = ViewBag.TotalPlaylists as int? ?? 0;
}

<div class="mis-playlists">
    <div class="page-header">
        <div class="header-info">
            <h2>Mis Playlists</h2>
            <p class="subtitle">@totalPlaylists playlists creadas</p>
        </div>
        @if (currentUser?.IsUserPremium == true)
        {
            <a href="@Url.Action("Create")" class="primary-button">➕ Crear Playlist</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert success-alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error-alert">
            @TempData["Error"]
        </div>
    }

    @if (Model.Any())
    {
        @if (currentUser?.IsUserFree == true && Model.Any())
        {
            <div class="alert info-alert">
                ℹ️ <strong>Usuario Gratuito:</strong> Puedes gestionar tus playlists existentes, pero necesitas ser Premium para crear nuevas.
                <a href="@Url.Action("Index", "Suscripciones")">Actualizar a Premium</a>
            </div>
        }
        <div class="playlists-list">
            @for (int i = 0; i < Model.Count; i++)
            {
                var playlist = Model[i];

                <div class="playlist-item">
                    <span class="playlist-number">@(i + 1)</span>
                    <div class="playlist-image">
                        @if (!string.IsNullOrEmpty(playlist.Imagen))
                        {
                            <img src="@playlist.Imagen" alt="@playlist.Nombre">
                        }
                        else
                        {
                            <div class="no-image">🎵</div>
                        }
                    </div>

                    <div class="playlist-info">
                        <a href="@Url.Action("Details", new { id = playlist.Id })" class="playlist-title">@playlist.Nombre</a>
                        <p class="playlist-details">
                            @playlist.TotalCanciones canciones
                            @if (playlist.DuracionTotal > 0)
                            {
                                <span> • @Math.Round(playlist.DuracionTotal, 0) min</span>
                            }
                        </p>
                        <span class="playlist-badge">@(playlist.EsPublica ? "🌐 Pública" : "🔒 Privada")</span>
                    </div>

                    <div class="playlist-actions">
                        @if (currentUser?.IsUserPremium == true || currentUser?.IsUserFree == true)
                        {
                            <a href="@Url.Action("Edit", new { id = playlist.Id })" class="edit-button">✏️</a>
                            <a href="@Url.Action("ConfirmarDelete", new { id = playlist.Id })" class="delete-button">🗑️</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎵</div>
            <h4>No tienes playlists</h4>
            @if (currentUser?.IsUserPremium == true)
            {
                <p>Crea tu primera playlist para organizar tu música</p>
                <a href="@Url.Action("Create")" class="primary-button">➕ Crear mi primera playlist</a>
            }
            else
            {
                <p>Las playlists que creaste cuando eras premium aparecerán aquí</p>
                <a href="@Url.Action("Index", "Suscripciones")" class="primary-button">🎵 Hazte Premium</a>
            }
    
        </div>
      
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/playlist.css" asp-append-version="true" />
}