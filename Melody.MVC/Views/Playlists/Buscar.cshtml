@model List<Melody.Modelos.DTOs.PlaylistDto>
@{
    ViewData["Title"] = "Buscar Playlists";
}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Resultados de búsqueda: "@ViewBag.TerminoBusqueda"</h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Ver todas las playlists</a>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var playlist in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(playlist.Imagen))
                        {
                            <img src="@playlist.Imagen" class="card-img-top" alt="@playlist.Nombre" style="height: 300px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                                <i class="fas fa-music text-muted" style="font-size: 4rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <a href="@Url.Action("Details", new { id = playlist.Id })" class="text-decoration-none">
                                <h5 class="card-title text-dark">@playlist.Nombre</h5>
                            </a>
                            <p class="card-text">
                                Por: @playlist.CreadorNombre @playlist.CreadorApellido<br>
                                <small class="text-muted">@playlist.TotalCanciones cancion(es)</small><br>
                                <span class="badge @(playlist.EsPublica ? "bg-success" : "bg-secondary")">
                                    @(playlist.EsPublica ? "Pública" : "Privada")
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No se encontraron playlists</h4>
            <p>No se encontraron playlists que coincidan con tu búsqueda "@ViewBag.TerminoBusqueda".</p>
            <a href="@Url.Action("Index")" class="btn btn-primary">Ver todas las playlists</a>
        </div>
    }
</div>