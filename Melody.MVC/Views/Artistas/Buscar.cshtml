@model IEnumerable<Melody.Modelos.Artista>
@{
    ViewData["Title"] = "Buscar Artistas";
}
<div class="artistas-index">
    <div class="search-header">
        <div class="search-info">
            <h2>Resultados de Búsqueda</h2>
            @if (!string.IsNullOrEmpty(ViewBag.TerminoBusqueda))
            {
                <p class="search-term">Para: "<strong>@ViewBag.TerminoBusqueda</strong>"</p>
            }
        </div>
        <form method="get" asp-action="Buscar" class="search-form">
            <input type="text" name="q" class="search-input" placeholder="Buscar artistas..." value="@ViewBag.TerminoBusqueda">
        </form>
    </div>

    @if (Model.Any())
    {
        <div class="artistas-grid">
            @foreach (var artista in Model)
            {
                <div class="artista-card">
                    <div class="card-image-circle">
                        @if (!string.IsNullOrEmpty(artista.ImagenPerfil))
                        {
                            <img src="@artista.ImagenPerfil" alt="@artista.NombreArtista">
                        }
                        else
                        {
                            <div class="no-image-circle">
                                <span>Sin imagen</span>
                            </div>
                        }
                    </div>
                    <div class="card-content">
                        <a href="@Url.Action("Details", new { id = artista.Id })" class="card-title">@artista.NombreArtista</a>
                        <p class="card-type">Artista</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h4>No se encontraron artistas</h4>
            @if (!string.IsNullOrEmpty(ViewBag.TerminoBusqueda))
            {
                <p>No hay artistas para "@ViewBag.TerminoBusqueda"</p>
            }
            else
            {
                <p>Intenta con otros términos de búsqueda</p>
            }
            <a href="@Url.Action("Index")" class="back-link">Volver a Artistas</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/artistas.css" asp-append-version="true" />
}