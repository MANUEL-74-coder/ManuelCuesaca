@model Melody.Modelos.DTOs.ArtistaDto

@{
    ViewData["Title"] = Model.NombreArtista;
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Auth.UserSessionInfo;
    var misPlaylists = ViewBag.MisPlaylists as List<Melody.Modelos.DTOs.PlaylistDto> ?? new List<Melody.Modelos.DTOs.PlaylistDto>();
}

<div class="content-wrapper perfil-usuario">
    <!-- Header del perfil público -->
    <div class="perfil-header">
        <div class="foto-perfil">
            @if (!string.IsNullOrEmpty(Model.ImagenPerfil))
            {
                <img src="@Model.ImagenPerfil" alt="@Model.NombreArtista" />
            }
            else
            {
                <div class="foto-placeholder">
                    <span>@Model.NombreArtista.Substring(0, 1)</span>
                </div>
            }
        </div>

        <h1>@Model.NombreArtista</h1>
        <p>
            <small>Miembro desde @Model.FechaRegistro.ToString("MMMM yyyy")</small>
        </p>

        <!-- Botón seguir/dejar de seguir -->
        @if (ViewBag.CurrentUser != null || currentUser.IsAdmin != true)
        {
            if (!Model.EsMiPerfil )
            {
                <form asp-action="ToggleSeguir" method="post" style="display: inline;">
                    <input type="hidden" name="artistaId" value="@Model.Id" />
                    @if (Model.EstaSiguiendo)
                    {
                        <button type="submit" class="btn btn-secondary">Siguiendo</button>
                    }
                    else
                    {
                        <button type="submit" class="btn-artista-especial">Seguir</button>
                    }
                </form>
            }
        }
        else
        {
            <a href="@Url.Action("Login", "Auth")" class="btn-artista-especial">Inicia sesión para seguir</a>
        }
    </div>

    <!-- Estadísticas públicas -->
    <div class="seccion-perfil">
        <h3>Estadísticas</h3>
        <div class="enlaces-rapidos">
            <div class="enlace-rapido">
                <strong>@Model.TotalSeguidores</strong>
                <br>
                <small>Seguidores</small>
            </div>
            <div class="enlace-rapido">
                <strong>@Model.TotalCanciones</strong>
                <br>
                <small>Canciones</small>
            </div>
            <div class="enlace-rapido">
                <strong>@Model.TotalAlbums</strong>
                <br>
                <small>Álbumes</small>
            </div>
        </div>
    </div>

    <!-- Biografía -->
    @if (!string.IsNullOrEmpty(Model.Biografia))
    {
        <div class="seccion-perfil">
            <h3>Biografía</h3>
            <div class="suscripcion-info">
                <p>@Model.Biografia</p>
            </div>
        </div>
    }

    <!-- Canciones populares -->
    @if (Model.Canciones != null && Model.Canciones.Any())
    {
        <div class="seccion-perfil">
            <h3>Canciones Populares</h3>

            <div class="play-section">
                <button onclick="playSong('@Model.Canciones.First().ArchivoAudioUrl', '@Model.Canciones.First().Titulo', '@Model.Canciones.First().ArtistaNombre', '@Model.Canciones.First().PortadaUrl', @Model.Canciones.First().Id)"
                        class="btn-artista-especial">
                    ▶️ Reproducir Todo
                </button>
            </div>

            <div class="songs-list">
                <div class="list-header">
                    <span class="col-num">#</span>
                    <span class="col-song">Título</span>
                    <span class="col-album">Álbum</span>
                    <span class="col-genero">Género</span>
                    <span class="col-duration">Duración</span>
                    <span class="col-actions">Acciones</span>
                </div>

                @for (int i = 0; i < Model.Canciones.Take(10).Count(); i++)
                {
                    var cancion = Model.Canciones.Skip(i).First();
                    <div class="song-item">
                        <span class="song-number">@(i + 1)</span>

                        <div class="song-info">
                            <img src="@cancion.PortadaUrl" alt="@cancion.Titulo" class="song-image">
                            <div class="song-text">
                                <a href="@Url.Action("Details", "Canciones", new { id = cancion.Id })" class="song-link">@cancion.Titulo</a>
                                <div class="artist-name">@cancion.ArtistaNombre</div>
                            </div>
                        </div>

                        <span class="song-album">
                            @if (cancion.AlbumId.HasValue)
                            {
                                <a href="@Url.Action("Details", "Albums", new { id = cancion.AlbumId })" class="album-link">@cancion.AlbumNombre</a>
                            }
                            else
                            {
                                @cancion.AlbumNombre
                            }
                        </span>

                        <span class="song-genero">@cancion.GeneroNombre</span>
                        <span class="song-duration">@(cancion.Duracion?.ToString(@"m\:ss") ?? "0:00")</span>

                        <div class="song-actions">
                            <button onclick="playSong('@cancion.ArchivoAudioUrl', '@cancion.Titulo', '@cancion.ArtistaNombre', '@cancion.PortadaUrl', @cancion.Id)"
                                    class="action-btn">
                                ▶️
                            </button>

                            @if (currentUser != null && (currentUser.IsUserFree || currentUser.IsUserPremium))
                            {
                                <button type="button" onclick="toggleMeGusta(@cancion.Id, this)"
                                        class="action-btn"
                                        data-cancion-id="@cancion.Id"
                                        data-es-favorito="@cancion.EsFavorito.ToString().ToLower()">
                                    @(cancion.EsFavorito ? "♥" : "♡")
                                </button>
                            }

                            @if (currentUser?.IsUserPremium == true && misPlaylists.Any())
                            {
                                <div class="dropdown">
                                    <button class="action-btn dropdown-toggle" data-bs-toggle="dropdown">➕</button>
                                    <ul class="dropdown-menu">
                                        @foreach (var playlist in misPlaylists)
                                        {
                                            <li>
                                                <form asp-controller="Canciones" asp-action="AgregarAPlaylist" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cancionId" value="@cancion.Id" />
                                                    <input type="hidden" name="playlistId" value="@playlist.Id" />
                                                    <button type="submit" class="dropdown-item">📋 @playlist.Nombre</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (currentUser?.IsUserPremium == true)
                            {
                                <a href="@Url.Action("Descargar", "Canciones", new { id = cancion.Id })"
                                   class="action-btn"
                                   title="Descargar canción">
                                    ⬇️
                                </a>
                            }
                            else if (currentUser?.IsUserFree == true)
                            {
                                <a href="/Suscripciones" class="action-btn">⭐</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="seccion-perfil">
            <div class="mensaje-especial">
                <p>Este artista aún no ha publicado canciones</p>
            </div>
        </div>
    }

    <!-- Acciones para fans -->
    <div class="seccion-perfil">
        <h3>Descubre más</h3>
        <div class="enlaces-rapidos">
            <a href="@Url.Action("Index", "Artistas")" class="enlace-rapido">
                Explorar más artistas
                <br>
                <small>Descubre nueva música</small>
            </a>
        </div>
    </div>
</div>
@section Styles {
	<link rel="stylesheet" href="~/css/artistas.css" asp-append-version="true" />
}