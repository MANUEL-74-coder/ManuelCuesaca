@model Melody.Modelos.DTOs.ArtistaDto

@{
    ViewData["Title"] = Model.NombreArtista;
}

<div class="content-wrapper perfil-usuario">
    <!-- Header del perfil público -->
    <div class="perfil-header">
        <div class="foto-perfil">
            @if (!string.IsNullOrEmpty(Model.ImagenPerfil))
            {
                <img src="@Model.ImagenPerfil" alt="@Model.NombreArtista" />
            }
            else
            {
                <div class="foto-placeholder">
                    <span>@Model.NombreArtista.Substring(0, 1)</span>
                </div>
            }
        </div>

        <h1>@Model.NombreArtista</h1>
        <p>
            <small>Miembro desde @Model.FechaRegistro.ToString("MMMM yyyy")</small>
        </p>

        <!-- Botón seguir/dejar de seguir -->
        @if (ViewBag.CurrentUser != null)
        {
            if (!Model.EsMiPerfil)
            {
                <form asp-action="ToggleSeguir" method="post" style="display: inline;">
                    <input type="hidden" name="artistaId" value="@Model.Id" />
                    @if (Model.EstaSiguiendo)
                    {
                        <button type="submit" class="btn btn-secondary">Siguiendo</button>
                    }
                    else
                    {
                        <button type="submit" class="btn-artista-especial">Seguir</button>
                    }
                </form>
            }
        }
        else
        {
            <a href="@Url.Action("Login", "Auth")" class="btn-artista-especial">Inicia sesión para seguir</a>
        }
    </div>

    <!-- Estadísticas públicas -->
    <div class="seccion-perfil">
        <h3>Estadísticas</h3>
        <div class="enlaces-rapidos">
            <div class="enlace-rapido">
                <strong>@Model.TotalSeguidores</strong>
                <br>
                <small>Seguidores</small>
            </div>
            <div class="enlace-rapido">
                <strong>@Model.TotalCanciones</strong>
                <br>
                <small>Canciones</small>
            </div>
            <div class="enlace-rapido">
                <strong>@Model.TotalAlbums</strong>
                <br>
                <small>Álbumes</small>
            </div>
        </div>
    </div>

    <!-- Biografía -->
    @if (!string.IsNullOrEmpty(Model.Biografia))
    {
        <div class="seccion-perfil">
            <h3>Biografía</h3>
            <div class="suscripcion-info">
                <p>@Model.Biografia</p>
            </div>
        </div>
    }

    <!-- Canciones populares -->
    @if (Model.Canciones != null && Model.Canciones.Any())
    {
        <div class="seccion-perfil">
            <h3>Canciones Populares</h3>
            <div class="table">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Canción</th>
                            <th>Álbum</th>
                            <th>Género</th>
                            <th>Duración</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cancion in Model.Canciones.Take(10))
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Canciones", new { id = cancion.Id })" class="text-decoration-none">
                                        <strong>@cancion.Titulo</strong>
                                    </a>
                                    @if (!string.IsNullOrEmpty(cancion.PortadaUrl))
                                    {
                                        <br>
                                        <small>🎵</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cancion.AlbumNombre))
                                    {
                                        @cancion.AlbumNombre
                                    }
                                    else
                                    {
                                        <em>Sencillo</em>
                                    }
                                </td>
                                <td>@cancion.GeneroNombre</td>
                                <td>
                                    @if (cancion.Duracion.HasValue)
                                    {
                                        @($"{cancion.Duracion.Value.Minutes:D2}:{cancion.Duracion.Value.Seconds:D2}")
                                    }
                                    else
                                    {
                                        <em>-</em>
                                    }
                                </td>
                                <td>@cancion.FechaLanzamiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <!-- Botón reproducir -->
                                        <button onclick="playSong('@cancion.ArchivoAudioUrl', '@cancion.Titulo', '@cancion.ArtistaNombre', '@cancion.PortadaUrl', @cancion.Id)"
                                                class="btn btn-success btn-sm">
                                            ▶️
                                        </button>

                                        <!-- Botón Me Gusta - Solo para usuarios free/premium -->
                                        @if (currentUser != null && (currentUser.IsUserFree || currentUser.IsUserPremium))
                                        {
                                            <button type="button" onclick="toggleMeGusta(@cancion.Id, this)"
                                                    class="btn btn-outline-secondary btn-sm me-gusta-btn"
                                                    data-cancion-id="@cancion.Id"
                                                    data-es-favorito="@cancion.EsFavorito.ToString().ToLower()"
                                                    title="@(cancion.EsFavorito ? "Quitar de favoritos" : "Agregar a favoritos")">
                                                @if (cancion.EsFavorito)
                                                {
                                                    <span style="color: red;">♥</span>
                                                }
                                                else
                                                {
                                                    <span style="color: gray;">♡</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="seccion-perfil">
            <div class="mensaje-especial">
                <p>Este artista aún no ha publicado canciones</p>
            </div>
        </div>
    }

    <!-- Acciones para fans -->
    <div class="seccion-perfil">
        <h3>Descubre más</h3>
        <div class="enlaces-rapidos">
            <a href="@Url.Action("Index", "Artistas")" class="enlace-rapido">
                Explorar más artistas
                <br>
                <small>Descubre nueva música</small>
            </a>
        </div>
    </div>
</div>

<!-- JavaScript para Me Gusta (igual que en Details de canciones) -->
<script>
    function toggleMeGusta(cancionId, buttonElement) {
        buttonElement.disabled = true;

        fetch('/Canciones/ToggleMeGustaAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'cancionId=' + cancionId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const isCurrentlyFavorite = buttonElement.dataset.esFavorito === 'true';
                const newState = !isCurrentlyFavorite;
                actualizarIconoCorazon(buttonElement, newState);
                buttonElement.dataset.esFavorito = newState.toString();
                showToast(data.message, 'success');
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error al procesar favorito', 'error');
        })
        .finally(() => {
            buttonElement.disabled = false;
        });
    }

    function actualizarIconoCorazon(buttonElement, esFavorito) {
        const heartSpan = buttonElement.querySelector('span');

        if (esFavorito) {
            heartSpan.innerHTML = '♥';
            heartSpan.style.color = 'red';
            buttonElement.title = 'Quitar de favoritos';
        } else {
            heartSpan.innerHTML = '♡';
            heartSpan.style.color = 'gray';
            buttonElement.title = 'Agregar a favoritos';
        }
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `
            ${message}
            <button type="button" class="btn-close" onclick="this.parentElement.remove()"></button>
        `;

        document.body.appendChild(toast);

        setTimeout(() => {
            if (toast.parentElement) {
                toast.remove();
            }
        }, 3000);
    }
</script>