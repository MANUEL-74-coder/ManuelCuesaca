@model List<Melody.Modelos.DTOs.MeGustaDto>
@{
    ViewData["Title"] = "Mis Favoritos";
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Auth.UserSessionInfo;
    var totalFavoritos = ViewBag.TotalFavoritos as int? ?? 0;
}

<div class="favoritos-index">
    <div class="hero-section">
        <div class="hero-icon">
            <span class="favorite-icon">❤️</span>
        </div>
        <div class="hero-info">
            <p class="content-type">PLAYLIST</p>
            <h1 class="playlist-title">Canciones que me gustan</h1>
            <div class="playlist-meta">
                <span>@currentUser?.UserName • @totalFavoritos canciones</span>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="songs-list">
            <div class="list-header">
                <span class="col-num">#</span>
                <span class="col-song">Canción</span>
                <span class="col-artist">Artista</span>
                <span class="col-genre">Género</span>
                <span class="col-album">Álbum</span>
                <span class="col-duration">Duración</span>
                <span class="col-date">Agregado</span>
                <span class="col-actions">Acciones</span>
            </div>

            @for (int i = 0; i < Model.Count; i++)
            {
                var favorito = Model[i];
                <div class="song-item">
                    <span class="song-number">@(i + 1)</span>

                    <div class="song-info">
                        <img src="@(string.IsNullOrEmpty(favorito.PortadaUrl) ? "/images/default-song.png" : favorito.PortadaUrl)"
                             alt="@favorito.CancionTitulo" class="song-image">
                        <div class="song-text">
                            <a href="@Url.Action("Details", "Canciones", new { id = favorito.CancionId })" class="song-link">@favorito.CancionTitulo</a>
                        </div>
                    </div>

                    <span class="song-artist">
                        <a href="@Url.Action("Details", "Artistas", new { id = favorito.ArtistaId })" class="artist-link">@favorito.ArtistaNombre</a>
                    </span>

                    <span class="song-genre">@favorito.GeneroNombre</span>

                    <span class="song-album">
                        @if (!string.IsNullOrEmpty(favorito.AlbumNombre) && favorito.AlbumNombre != "Sin Álbum")
                        {
                            <a href="@Url.Action("Details", "Albums", new { id = favorito.AlbumId })" class="album-link">@favorito.AlbumNombre</a>
                        }
                        else
                        {
                            <span class="no-album">Sin Álbum</span>
                        }
                    </span>

                    <span class="song-duration">@(favorito.Duracion?.ToString(@"m\:ss") ?? "0:00")</span>

                    <span class="song-date">@favorito.FechaAgregado.ToString("dd/MM/yyyy")</span>

                    <div class="song-actions">
                        <button onclick="playSong('@favorito.ArchivoAudioUrl', '@favorito.CancionTitulo', '@favorito.ArtistaNombre', '@favorito.PortadaUrl', @favorito.CancionId)"
                                class="action-btn play-btn">
                            ▶️
                        </button>

                        <button type="button" onclick="toggleMeGusta(@favorito.CancionId, this)" class="action-btn remove-btn"
                                data-cancion-id="@favorito.CancionId" data-es-favorito="true"
                                title="Quitar de favoritos">
                            💔
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">💔</div>
            <h4>No tienes canciones favoritas</h4>
            <p>Explora música y agrega canciones a tus favoritos</p>
            <a href="@Url.Action("Index", "Canciones")" class="primary-button">Explorar Música</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert success-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert error-alert">
        @TempData["Error"]
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/favoritos.css" asp-append-version="true" />
}