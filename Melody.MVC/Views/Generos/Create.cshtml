@model Melody.Modelos.Genero

@{
    ViewData["Title"] = "Agregar Género Musical";
}

<div class="container mt-4">
    <h1>Agregar</h1>
    <h4>Género</h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" asp-antiforgery="true">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" aria-describedby="nombreHelp" />
                    <small id="nombreHelp" class="form-text text-muted">Ingrese el nombre del género musical.</small>
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Agregar" class="btn btn-primary" aria-label="Agregar género musical" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Regresar</a>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}