@model Melody.Modelos.Genero

@{
    ViewData["Title"] = "Editar Género Musical";
}

<div class="container mt-4">
    <h1 class="mb-3">@ViewData["Title"]</h1>
    <h4 class="mb-3">Género Musical</h4>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="form-group mb-3">
                    <label asp-for="Id" class="form-label"></label>
                    <input asp-for="Id" class="form-control" readonly />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" aria-describedby="nombreHelp" />
                    <small id="nombreHelp" class="form-text text-muted">Modifica el nombre del género musical.</small>
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar cambios
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Regresar a Géneros
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}