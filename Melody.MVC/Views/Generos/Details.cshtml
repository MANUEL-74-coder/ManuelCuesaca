@model Melody.Modelos.Genero
@{
    ViewData["Title"] = "Detalles del Género";
}

<<div class="content-wrapper">
    <h1> @Html.DisplayFor(model => model.Nombre)</h1>
    <div>
        <dl class="row">
            <!-- Solo mostrar ID si es admin -->
            @if (User.IsInRole("admin"))
            {
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Id)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Id)
                </dd>
            }
            <dt class="col-sm-2">
                Total Álbumes
            </dt>
            <dd class="col-sm-10">
                @(Model.Albums?.Count ?? 0)
            </dd>
            <dt class="col-sm-2">
                Total Canciones
            </dt>
            <dd class="col-sm-10">
                @(Model.Canciones?.Count ?? 0)
            </dd>
        </dl>
    </div>

    <!-- Sección de Contenido Musical -->
    @{
        var tieneAlbumes = (Model.Albums?.Count ?? 0) > 0;
        var tieneCanciones = (Model.Canciones?.Count ?? 0) > 0;
        var tieneContenido = tieneAlbumes || tieneCanciones;
    }

    @if (tieneContenido)
    {
        <div class="content-section">
            <!-- Tabla de Álbumes - Solo si hay álbumes -->
            @if (tieneAlbumes)
            {
                <div class="table-section">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Álbum</th>
                                <th>Artista</th>
                                <th>Fecha Lanzamiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var album in Model.Albums)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-controller="Albums" asp-route-id="@album.Id" class="content-link">
                                            @album.Titulo
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-controller="Artistas" asp-route-id="@album.ArtistaId" class="content-link">
                                            @album.Artista?.NombreArtista
                                        </a>
                                    </td>
                                    <td>@album.FechaLanzamiento.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }


            <!-- Tabla de Canciones - SOLO si hay canciones -->
            @if (tieneCanciones)
            {
                <div class="table-section">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Canción</th>
                                <th>Artista</th>
                                <th>Fecha Lanzamiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cancion in Model.Canciones)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-controller="Canciones" asp-route-id="@cancion.Id" class="content-link">
                                            @cancion.Titulo
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-controller="Artistas" asp-route-id="@cancion.ArtistaId" class="content-link">
                                            @cancion.Artista?.NombreArtista
                                        </a>
                                    </td>
                                    <td>@cancion.FechaLanzamiento.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Mensaje cuando NO hay contenido musical -->
        <div class="empty-genre-message">
            <p>No hay álbumes ni canciones disponibles en <strong>@Model.Nombre</strong> por el momento.</p>
            @if (User.IsInRole("artista"))
            {
                <div class="artist-suggestion">
                    <a asp-controller="Canciones" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        ¡Sé el primero en subir una canción!
                    </a>
                </div>
            }
        </div>
    }

    <div class="navigation-links">
        <!-- Enlace editar solo para admin-->
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Géneros
        </a>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}