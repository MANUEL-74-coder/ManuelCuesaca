@model IEnumerable<Melody.Modelos.Genero>

@{
    ViewData["Title"] = "Index";
}

<div class="content-wrapper">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <h1>Géneros</h1>
    @if (User.IsInRole("admin"))
    {
        <p>
            <a asp-action="Create">Agregar Género Musical</a>
        </p>
    }


    <table class="table">
        <thead>
            <tr>
                @if (User.IsInRole("admin"))
                {
                    <th>ID</th>
                }
                <th>
                    NOMBRE
                </th>
                @if (User.IsInRole("admin"))
                {
                    <th>ACCIONES</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (User.IsInRole("admin"))
                    {
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                    }
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="genre-name-link">
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </a>
                    </td>
                    @if (User.IsInRole("admin"))
                    {
                        <td>
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }) |
                            @Html.ActionLink("Detalles", "Details", new { id = item.Id }) |
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id })
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if (!User.IsInRole("admin"))
    {
        <div class="user-info-section">
            <p class="text-center text-muted">
                <i class="bi bi-info-circle"></i>
                Haz clic en cualquier género para explorar sus álbumes y canciones
            </p>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}