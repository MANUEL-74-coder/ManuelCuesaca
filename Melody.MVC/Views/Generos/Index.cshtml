@model IEnumerable<Melody.Modelos.Genero>

@{
    ViewData["Title"] = "Géneros Musicales";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle" aria-hidden="true"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Géneros Musicales</h1>
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus"></i> Agregar Género Musical
            </a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    @if (User.IsInRole("admin"))
                    {
                        <th scope="col">ID</th>
                    }
                    <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
                    @if (User.IsInRole("admin"))
                    {
                        <th scope="col">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (User.IsInRole("admin"))
                        {
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        }
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="genre-name-link text-decoration-none" title="Ver detalles de @item.Nombre">
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </a>
                        </td>
                        @if (User.IsInRole("admin"))
                        {
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Editar">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Detalles">
                                    <i class="fas fa-info-circle"></i> Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="fas fa-trash-alt"></i> Eliminar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!User.IsInRole("admin"))
    {
        <div class="user-info-section mt-4">
            <p class="text-center text-muted">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Haz clic en cualquier género para explorar sus álbumes y canciones.
            </p>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}