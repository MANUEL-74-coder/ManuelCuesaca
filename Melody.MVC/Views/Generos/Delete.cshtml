@model Melody.Modelos.Genero
@{
    ViewData["Title"] = "Eliminar género musical";
}

<div class="content-wrapper">
    <h1>@ViewData["Title"]</h1>
    <p>¡Si hay contenido asociado a este género músical no podrás eliminarlo!</p>
    <h3 style="text-align: center;">¿Estás seguro de eliminar este género musical?</h3>

    <div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Id)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Id)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
            </dl>
        </div>

        <form asp-action="Delete">
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            <a asp-action="Index">Regresar a Géneros</a>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/generos.css" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}