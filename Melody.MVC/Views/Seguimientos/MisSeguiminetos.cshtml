@model List<Melody.Modelos.Seguimiento>
@{
    ViewData["Title"] = "Mis Seguimientos";
    var currentUser = ViewBag.CurrentUser as Melody.Modelos.Usuario;
}

<div class="seguimientos-index">
    <div class="page-header">
        <div class="header-info">
            <h2>Mis Seguimientos</h2>
            <p class="subtitle">Sigues a @Model.Count() artistas</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="seguimientos-list">
            @foreach (var seguimiento in Model)
            {
                <div class="seguimiento-item">
                    <div class="artista-image">
                        @if (!string.IsNullOrEmpty(seguimiento.Artista?.ImagenPerfil))
                        {
                            <img src="@seguimiento.Artista.ImagenPerfil" alt="@seguimiento.Artista.NombreArtista">
                        }
                        else
                        {
                            <div class="no-image">👤</div>
                        }
                    </div>

                    <div class="artista-info">
                        <a href="@Url.Action("Details", "Artistas", new { id = seguimiento.Artista?.Id })" class="artista-name">
                            @seguimiento.Artista?.NombreArtista
                            <span class="verified-badge">✓</span>
                        </a>
                        <p class="artista-details">
                            @@@(seguimiento.Artista?.NombreArtista?.ToLower().Replace(" ", "")) •
                            Siguiendo desde @seguimiento.FechaSeguimiento.ToString("dd/MM/yyyy")
                        </p>
                    </div>

                    <div class="artista-actions">
                        <form asp-controller="Artistas" asp-action="ToggleSeguir" method="post" class="unfollow-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="artistaId" value="@seguimiento.Artista?.Id" />
                            <button type="submit" class="unfollow-button">Dejar de Seguir</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎤</div>
            <h4>No sigues a ningún artista aún</h4>
            <p>Descubre nuevos artistas y comienza a seguir a tus favoritos</p>
            <a href="@Url.Action("Index", "Artistas")" class="primary-button">Explorar Artistas</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert success-alert">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert error-alert">
        @TempData["Error"]
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/seguimientos.css" asp-append-version="true" />
}